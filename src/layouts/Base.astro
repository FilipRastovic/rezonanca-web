---
import '@fontsource/unbounded/300.css';
import '@fontsource/unbounded/400.css';
import '@fontsource/unbounded/500.css';
import '@fontsource/unbounded/600.css';
import '@fontsource/unbounded/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import OrderModal from '../components/OrderModal.astro';
import { T, altHref, type Lang } from '../i18n';

interface Props { lang: Lang; title?: string; description?: string; image?: string }
const { lang } = Astro.props;
const t = T[lang];
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const image = new URL(Astro.props.image ?? `/og-${lang}.jpg`, Astro.site);
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#01030a" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="sr" href={new URL(altHref(path, 'sr'), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(altHref(path, 'en'), Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <slot name="head" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <Nav lang={lang} />
    <main><slot /></main>
    <Footer lang={lang} />
    <OrderModal lang={lang} />
    <script>
      // Scroll reveal.
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Quantity steppers.
      const syncStep = (input: HTMLInputElement) => {
        const v = +input.value, s = input.parentElement!;
        (s.querySelector('[data-step="-1"]') as HTMLButtonElement).disabled = v <= +input.min;
        (s.querySelector('[data-step="1"]') as HTMLButtonElement).disabled = v >= +input.max;
      };
      document.addEventListener('click', (e) => {
        const b = (e.target as Element).closest<HTMLButtonElement>('.stepper .step');
        if (!b) return;
        const input = b.parentElement!.querySelector('input') as HTMLInputElement;
        input.value = String(Math.min(+input.max, Math.max(+input.min, (+input.value || 1) + +b.dataset.step!)));
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
      });
      document.addEventListener('input', (e) => { const i = e.target as HTMLInputElement; if (i.closest?.('.stepper')) syncStep(i); });
      document.querySelectorAll<HTMLInputElement>('.stepper input').forEach(syncStep);

      // Rails: prev/next arrows + position counter under every horizontal product row.
      document.querySelectorAll<HTMLElement>('.rail').forEach((rail) => {
        const nav = document.createElement('div');
        nav.className = 'rail-nav';
        nav.innerHTML = '<span class="count"></span><button type="button" aria-label="←">←</button><button type="button" aria-label="→">→</button>';
        rail.after(nav);
        const [prev, next] = nav.querySelectorAll('button');
        const count = nav.querySelector('.count')!;
        const items = () => [...rail.children] as HTMLElement[];
        const step = () => (items()[0]?.getBoundingClientRect().width ?? 300) + parseFloat(getComputedStyle(rail).columnGap || '0');
        const update = () => {
          const max = rail.scrollWidth - rail.clientWidth - 2;
          prev.disabled = rail.scrollLeft <= 2;
          next.disabled = rail.scrollLeft >= max;
          nav.hidden = max <= 0;
          const first = Math.round(rail.scrollLeft / step()) + 1;
          const visible = Math.max(1, Math.round(rail.clientWidth / step()));
          const total = items().length;
          count.textContent = `${String(first).padStart(2, '0')}${visible > 1 ? '–' + String(Math.min(total, first + visible - 1)).padStart(2, '0') : ''} / ${String(total).padStart(2, '0')}`;
        };
        prev.addEventListener('click', () => rail.scrollBy({ left: -step() }));
        next.addEventListener('click', () => rail.scrollBy({ left: step() }));
        rail.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
        addEventListener('resize', update);
        update();
      });
    </script>
  </body>
</html>
