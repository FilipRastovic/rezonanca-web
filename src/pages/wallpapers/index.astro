---
// Free phone wallpapers (Marketing, 2026-11-11): six attractors in ice blue, 1440x3120, no email gate.
// Files in public/wallpapers/ (from marketing/wallpapers-2026-11/phone/). Only veil-01 is a product.
import Base from '../../layouts/Base.astro';
import { homeHref, productHref, collectionHref } from '../../i18n';
const site = Astro.site!;
const WALLS = [
  { file: 'veil-01-clifford', name: 'Cup', eq: 'Clifford map, a = 1.7, b = 1.7, c = 0.6, d = 1.2', print: productHref('en', 'klifordov-veo') },
  { file: 'veil-02-clifford', name: 'Clifford attractor', eq: 'Clifford map, a = -1.4, b = 1.6, c = 1.0, d = 0.7' },
  { file: 'veil-03-clifford', name: 'Clifford attractor', eq: 'Clifford map, a = -1.7, b = 1.3, c = -0.1, d = -1.2' },
  { file: 'veil-04-de-jong', name: 'De Jong attractor', eq: 'De Jong map, a = -2.0184, b = -1.9901, c = -1.1959, d = 2.0221' },
  { file: 'veil-05-de-jong', name: 'De Jong attractor', eq: 'De Jong map, a = 1.3817, b = -2.2838, c = 2.382, d = -2.0753' },
  { file: 'veil-06-thomas', name: 'Thomas attractor', eq: 'Thomas system, b = 0.18' },
] as { file: string; name: string; eq: string; print?: string }[];
const full = (f: string) => `/wallpapers/${f}-1440x3120.jpg`;
const title = 'Free Strange Attractor Phone Wallpapers | Rezonanca';
const desc = 'Six strange attractor phone wallpapers made with code: Clifford, De Jong and Thomas in ice blue. Free download, 1440x3120, fits any phone.';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [['Home', homeHref()], ['Wallpapers', '/wallpapers/']].map(([name, href], i) => ({ '@type': 'ListItem', position: i + 1, name, item: new URL(href, site).href })) },
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Free strange attractor phone wallpapers', description: desc, url: new URL('/wallpapers/', site).href,
    hasPart: WALLS.map((w) => ({ '@type': 'ImageObject', name: `${w.name} phone wallpaper`, contentUrl: new URL(full(w.file), site).href, thumbnailUrl: new URL(`/wallpapers/${w.file}-720.webp`, site).href, creator: { '@type': 'Organization', name: 'Rezonanca' } })) },
];
---
<Base lang="en" title={title} description={desc}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="top grid-bg">
    <div class="wrap">
      <nav class="crumbs mono" aria-label="Breadcrumb"><a href={homeHref()}>Home</a><span>/</span><span aria-current="page">Wallpapers</span></nav>
      <p class="label">Free download</p>
      <h1>Strange attractor phone wallpapers</h1>
      <p class="lead">Six chaotic systems in ice blue, each one equation followed for millions of steps and drawn in code. Free for your phone: 1440x3120, fits every iPhone and most Android phones. No sign-up.</p>
    </div>
  </section>
  <section class="list">
    <div class="wrap grid">
      {WALLS.map((w, i) => (
        <article class="card">
          <a class="shot" href={full(w.file)} target="_blank" rel="noopener">
            <img src={`/wallpapers/${w.file}-360.webp`} srcset={`/wallpapers/${w.file}-360.webp 360w, /wallpapers/${w.file}-720.webp 720w`} sizes="(max-width: 560px) 90vw, (max-width: 900px) 45vw, 30vw" alt={`${w.name} phone wallpaper, light blue lines on a deep navy ground`} width="720" height="1560" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
          </a>
          <span class="k mono">{String(i + 1).padStart(2, '0')}</span>
          <h2>{w.name}</h2>
          <p class="eq mono">{w.eq}</p>
          <div class="dl">
            <a class="btn btn--solid" href={full(w.file)} download data-wall={w.file}>Download <span class="mono">1440x3120</span></a>
            {w.print && <a class="btn" href={w.print}>Get it as a print</a>}
          </div>
        </article>
      ))}
    </div>
    <div class="wrap note">
      <p>For personal use: set them as your wallpaper, share them with a link back.</p>
      <div class="dl"><a class="btn" href="/play/">Make your own</a><a class="btn" href={collectionHref('en')}>See all prints</a></div>
    </div>
  </section>
</Base>
<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-wall]').forEach((a) =>
    a.addEventListener('click', () => (window as any).rzTrack?.('file_download', { content_name: a.dataset.wall })));
</script>
<style>
  .top { padding: clamp(140px, 14vw, 200px) 0 var(--space-md); background-color: var(--bg-0); border-bottom: 1px solid var(--line); }
  .crumbs { display: flex; gap: 10px; flex-wrap: wrap; font-size: var(--fs-2xs); letter-spacing: var(--track-ui); text-transform: uppercase; color: var(--muted); margin-bottom: 36px; }
  .crumbs a:hover { color: var(--cyan); }
  .crumbs [aria-current] { color: var(--ice); }
  h1 { font-size: var(--fs-h1); line-height: 1.1; margin-top: 20px; text-wrap: balance; }
  .lead { margin-top: 20px; max-width: 62ch; }
  .list { background: var(--bg-1); padding-block: var(--space-md); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(28px, 3vw, 48px); }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
  .card { display: grid; gap: 10px; align-content: start; }
  .shot img { width: 100%; height: auto; aspect-ratio: 1440 / 3120; object-fit: cover; background: var(--bg-0); margin-bottom: 8px; transition: opacity 0.3s; }
  @media (max-width: 560px) { .shot img { aspect-ratio: 3 / 4; object-position: 50% 45%; } }
  .shot:hover img { opacity: 0.9; }
  .k { font-size: var(--fs-2xs); letter-spacing: var(--track-label); color: var(--muted); }
  h2 { font-size: var(--fs-h3); }
  .eq { margin: 0; color: var(--muted); font-size: var(--fs-2xs); line-height: 1.6; }
  .dl { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  .dl .btn { flex: 1 1 140px; justify-content: center; gap: 8px; }
  .dl .mono { font-size: var(--fs-2xs); opacity: 0.75; }
  .note { display: grid; gap: 20px; justify-items: start; margin-top: var(--space-md); padding-top: var(--space-sm); border-top: 1px solid var(--line); }
  .note p { margin: 0; max-width: 62ch; color: var(--text); }
</style>
