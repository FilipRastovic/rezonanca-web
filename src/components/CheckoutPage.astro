---
import Base from '../layouts/Base.astro';
import { SHOP } from '../config';
import { T, homeHref, cartHref, collectionHref, legalHref, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang].cart, o = T[lang].order;
const cfg = JSON.stringify({ inbox: SHOP.orderInbox, shop: SHOP.name, email: SHOP.email });
---
<Base lang={lang} title={`${t.checkoutTitle} | Резонанца`} description={t.checkoutTitle}>
  <section class="page grid-bg">
    <div class="wrap">
      <nav class="crumbs mono"><a href={homeHref(lang)}>{T[lang].product.home}</a><span>/</span><a href={cartHref(lang)}>{t.title}</a><span>/</span><span aria-current="page">{t.checkoutTitle}</span></nav>

      <div id="co-empty" class="empty panel" hidden>
        <p>{t.empty}</p>
        <a class="btn btn--solid" href={collectionHref(lang)}>{t.emptyCta} <span class="arrow">→</span></a>
      </div>

      <div id="co-main" hidden>
        <p class="label">{t.checkoutLabel}</p>
        <h1>{t.checkoutTitle}</h1>
        <div class="layout">
          <form id="co-form" class="fields panel" novalidate data-config={cfg}>
            <h2 class="h mono">{t.details}</h2>
            <label class="full">{o.name}<input name="name" required autocomplete="name" /></label>
            <label>{o.phone}<input name="phone" type="tel" required autocomplete="tel" /></label>
            <label>{o.email}<input name="email" type="email" required autocomplete="email" /></label>
            <label class="full">{o.address}<input name="address" required autocomplete="street-address" /></label>
            <label>{o.city}<input name="city" required autocomplete="address-level2" /></label>
            <label>{o.zip}<input name="zip" required autocomplete="postal-code" inputmode="numeric" /></label>
            <label class="full">{o.note}<textarea name="note" rows="3"></textarea></label>
            <fieldset class="full">
              <legend>{o.payment}</legend>
              <label class="radio"><input type="radio" name="payment" value="cod" checked /> {o.payments.cod}</label>
              <label class="radio"><input type="radio" name="payment" value="bank" /> {o.payments.bank}</label>
            </fieldset>
            <label class="radio agree full"><input type="checkbox" name="terms" required value="yes" />
              <span>{lang === 'sr' ? 'Прихватам ' : 'I accept the '}<a href={legalHref(lang, 'terms')} target="_blank">{T[lang].legal.terms.title.toLowerCase()}</a>{lang === 'sr' ? ' и ' : ' and '}<a href={legalHref(lang, 'privacy')} target="_blank">{T[lang].legal.privacy.title.toLowerCase()}</a></span></label>
            <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <p class="status full" role="status" aria-live="polite"></p>
            <button class="btn btn--solid submit full" type="submit" data-label={t.place} data-sending={o.sending}>{t.place} <span class="arrow">→</span></button>
          </form>

          <aside class="summary panel">
            <div class="sh"><span class="h mono">{t.summary}</span><a class="link mono" href={cartHref(lang)}>{t.edit}</a></div>
            <ul class="lines" id="co-lines"></ul>
            <div class="row"><span>{t.subtotal}</span><span id="co-subtotal"></span></div>
            <div class="row muted"><span>{t.shipping}</span><span id="co-shipping"></span></div>
            <div class="row total"><span>{t.total}</span><strong id="co-total"></strong></div>
            <p class="note">{t.note}</p>
          </aside>
        </div>
      </div>

      <div id="co-done" class="done panel" hidden aria-live="polite">
        <div class="check" aria-hidden="true"><svg viewBox="0 0 52 52"><circle cx="26" cy="26" r="24"/><path d="M15 27 l8 8 l15 -17"/></svg></div>
        <h2>{o.doneTitle}</h2>
        <p class="lead">{o.doneLead}</p>
        <ul class="lines" id="co-done-lines"></ul>
        <p class="donetotal"><span>{t.total}</span> <strong id="co-done-total"></strong></p>
        <p class="note">{o.doneNote} <a href={`mailto:${SHOP.email}`}>{SHOP.email}</a></p>
        <p class="demo mono" hidden>{o.demo}</p>
        <a class="btn btn--solid" href={homeHref(lang)}>{o.doneClose} <span class="arrow">→</span></a>
      </div>
    </div>
  </section>
  <template id="co-msgs" data-required={o.required} data-error={o.error}></template>
</Base>
<script>
  import { totals, catalog, money, describe, clear } from '../scripts/cart';
  const form = document.getElementById('co-form') as HTMLFormElement;
  const cfg = JSON.parse(form.dataset.config!);
  const msgs = (document.getElementById('co-msgs') as HTMLElement).dataset;
  const status = form.querySelector('.status') as HTMLElement;
  const submit = form.querySelector('.submit') as HTMLButtonElement;

  const fillLines = (ul: HTMLElement) => {
    const c = catalog(), { lines } = totals();
    ul.innerHTML = '';
    for (const l of lines) {
      const p = c.products[l.slug];
      if (!p) continue;
      const li = document.createElement('li');
      li.innerHTML = '<img alt="" width="48" height="64"><div><span class="n"></span><span class="d"></span></div><span class="p"></span>';
      (li.querySelector('img') as HTMLImageElement).src = p.img;
      li.querySelector('.n')!.textContent = `${p.name}${l.qty > 1 ? ' × ' + l.qty : ''}`;
      li.querySelector('.d')!.textContent = describe(l);
      li.querySelector('.p')!.textContent = money(c.prices[l.format][l.size] * l.qty);
      ul.append(li);
    }
  };
  const render = () => {
    const { lines, subtotal, shipping, total } = totals();
    if (!document.getElementById('co-done')!.hidden) return;
    document.getElementById('co-empty')!.hidden = lines.length > 0;
    document.getElementById('co-main')!.hidden = lines.length === 0;
    fillLines(document.getElementById('co-lines')!);
    document.getElementById('co-subtotal')!.textContent = money(subtotal);
    document.getElementById('co-shipping')!.textContent = money(shipping);
    document.getElementById('co-total')!.textContent = money(total);
  };
  document.addEventListener('cart:change', render);
  render();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.classList.remove('err');
    let firstBad: HTMLElement | null = null;
    for (const el of form.querySelectorAll<HTMLInputElement>('input[required]')) {
      const bad = el.type === 'checkbox' ? !el.checked : !el.checkValidity() || !el.value.trim();
      el.setAttribute('aria-invalid', String(bad));
      if (bad && !firstBad) firstBad = el;
    }
    if (firstBad) { status.classList.add('err'); status.textContent = msgs.required!; firstBad.focus(); return; }
    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    if (data.botcheck) return;
    const c = catalog(), { lines, subtotal, shipping, total } = totals();
    const items = lines.map((l) => `${l.qty} × ${c.products[l.slug]?.name} (${l.slug}) - ${describe(l)} = ${money(c.prices[l.format][l.size] * l.qty)}`).join('\n');
    const { botcheck, terms, ...fields } = data;
    const payload = {
      _subject: `${cfg.shop} - поруџбина: ${lines.reduce((a, l) => a + l.qty, 0)} ком. / ${money(total)}`,
      _template: 'table',
      _replyto: data.email,
      ...fields,
      items,
      subtotal: money(subtotal),
      shipping: money(shipping),
      total: money(total),
      terms_accepted: terms ? 'yes' : 'no',
      language: c.lang,
    };
    submit.disabled = true;
    submit.firstChild!.textContent = submit.dataset.sending! + ' ';
    try {
      if (!cfg.inbox) { console.info('[order demo]', payload); await new Promise((r) => setTimeout(r, 600)); }
      else {
        const res = await fetch(`https://formsubmit.co/ajax/${cfg.inbox}`, {
          method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(payload),
        });
        const json = await res.json();
        if (String(json.success) !== 'true') throw new Error(json.message);
      }
      fillLines(document.getElementById('co-done-lines')!);
      document.getElementById('co-done-total')!.textContent = money(total);
      (document.querySelector('#co-done .demo') as HTMLElement).hidden = !!cfg.inbox;
      document.getElementById('co-main')!.hidden = true;
      document.getElementById('co-done')!.hidden = false;
      scrollTo({ top: 0 });
      clear();
    } catch (err) {
      console.error(err);
      status.classList.add('err');
      status.textContent = `${msgs.error} ${cfg.email}`;
    } finally {
      submit.disabled = false;
      submit.firstChild!.textContent = submit.dataset.label! + ' ';
    }
  });
</script>
<style>
  .page { padding-top: clamp(130px, 13vw, 180px); background-color: var(--bg-0); min-height: 80vh; }
  .crumbs { display: flex; gap: 10px; flex-wrap: wrap; font-size: var(--fs-2xs); letter-spacing: var(--track-ui); text-transform: uppercase; color: var(--muted); margin-bottom: 32px; }
  .crumbs a:hover { color: var(--cyan); }
  h1 { font-size: var(--fs-h1); margin-top: 16px; }
  .empty { margin-top: var(--space-md); display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .empty p { margin: 0; font-size: var(--fs-lead); }
  .layout { margin-top: var(--space-md); display: grid; grid-template-columns: 1fr 400px; gap: clamp(24px, 4vw, 56px); align-items: start; }
  .h { font-size: var(--fs-2xs); letter-spacing: var(--track-label); text-transform: uppercase; color: var(--cyan); font-weight: 500; margin: 0; }
  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 18px; }
  .fields .h { grid-column: 1 / -1; margin-bottom: 6px; max-width: none; }
  .full { grid-column: 1 / -1; }
  label, legend { display: flex; flex-direction: column; gap: 8px; font: 500 var(--fs-2xs)/1 var(--f-mono); letter-spacing: var(--track-ui); text-transform: uppercase; color: var(--muted); }
  input, textarea { width: 100%; padding: 13px 14px; background: rgba(1, 3, 10, 0.8); border: 1px solid var(--line); color: var(--ice); font: 400 16px/1.3 var(--f-body); letter-spacing: 0; text-transform: none; border-radius: 0; }
  input:focus, textarea:focus { outline: none; border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(80, 230, 255, 0.12); }
  [aria-invalid='true'] { border-color: #ff5f7a; }
  fieldset { border: none; padding: 0; margin: 0; display: flex; gap: 24px; flex-wrap: wrap; }
  legend { margin-bottom: 10px; }
  .radio { flex-direction: row; align-items: center; gap: 10px; font: 400 var(--fs-body)/1.4 var(--f-body); letter-spacing: 0; text-transform: none; color: var(--ice); cursor: pointer; }
  .radio input { width: 18px; height: 18px; accent-color: var(--cyan); flex: none; }
  .agree a { color: var(--cyan); text-decoration: underline; text-underline-offset: 3px; }
  .hp { display: none; }
  .status { margin: 0; min-height: 1.2em; font-size: var(--fs-sm); color: var(--cyan); }
  .status.err { color: #ff8da0; }
  .submit { justify-content: center; padding: 18px; }
  .submit[disabled] { opacity: 0.6; cursor: wait; }
  .summary { position: sticky; top: 100px; display: grid; gap: 12px; }
  .sh { display: flex; justify-content: space-between; align-items: center; }
  .link { font-size: var(--fs-2xs); letter-spacing: var(--track-ui); text-transform: uppercase; color: var(--muted); text-decoration: underline; text-underline-offset: 4px; }
  .lines { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .lines :global(li) { display: grid; grid-template-columns: 48px 1fr auto; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); align-items: center; }
  .lines :global(img) { width: 48px; height: 64px; object-fit: cover; border: 1px solid var(--line); }
  .lines :global(div) { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .lines :global(.n) { color: var(--ice); font-size: var(--fs-body); }
  .lines :global(.d) { color: var(--muted); font-size: var(--fs-2xs); }
  .lines :global(.p) { color: var(--ice); font-size: var(--fs-sm); white-space: nowrap; }
  .row { display: flex; justify-content: space-between; font-size: var(--fs-body); }
  .muted { color: var(--muted); font-size: var(--fs-sm); }
  .total { padding-top: 12px; border-top: 1px solid var(--line); }
  .total strong { font: 500 var(--fs-price)/1 var(--f-display); color: var(--ice); }
  .note { margin: 4px 0 0; color: var(--muted); font-size: var(--fs-sm); }
  .done { max-width: 640px; margin: 0 auto; text-align: center; }
  .check svg { width: 64px; height: 64px; fill: none; stroke: var(--cyan); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 10px rgba(80,230,255,.6)); }
  .check circle { stroke-dasharray: 160; stroke-dashoffset: 160; animation: draw-c 0.7s ease forwards; }
  .check path { stroke-dasharray: 40; stroke-dashoffset: 40; animation: draw-c 0.4s 0.6s ease forwards; }
  @keyframes draw-c { to { stroke-dashoffset: 0; } }
  .done h2 { margin: 20px auto 0; font-size: var(--fs-h2); }
  .done .lead { margin: 16px auto 28px; }
  .done .lines { text-align: left; }
  .donetotal { display: flex; justify-content: space-between; margin: 14px 0 0; color: var(--ice); }
  .done .note a { color: var(--cyan); }
  .done .btn { margin-top: 26px; }
  .demo { font-size: var(--fs-2xs); color: var(--muted); }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } .summary { position: static; order: -1; } }
  @media (max-width: 520px) { .fields { grid-template-columns: 1fr; } }
</style>
