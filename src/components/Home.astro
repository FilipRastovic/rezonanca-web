---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Manifesto from './Manifesto.astro';
import Series from './Series.astro';
import Interiors from './Interiors.astro';
import Formats from './Formats.astro';
import HowToOrder from './HowToOrder.astro';
import Faq from './Faq.astro';
import FinalCta from './FinalCta.astro';
import About from './About.astro';
import MathArt from './MathArt.astro';
import SocialFeed from './SocialFeed.astro';
import { SHOP } from '../config';
import { T } from '../i18n';
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const seo = T[lang].seo;
const site = Astro.site!.href;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Rezonanca', url: site, logo: new URL('/icon-512.png', site).href, email: SHOP.email,
    description: seo.homeDesc, address: { '@type': 'PostalAddress', addressLocality: 'Novi Sad', addressCountry: 'RS' },
    sameAs: [SHOP.instagram, SHOP.tiktok, SHOP.facebook, SHOP.etsy].filter(Boolean) },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Rezonanca', url: site },
];
---
<Base lang={lang} title={seo.homeTitle} description={seo.homeDesc}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Hero lang={lang} />
  <Series lang={lang} />
  <Manifesto lang={lang} />
  <MathArt lang={lang} />
  <About lang={lang} />
  <Interiors lang={lang} />
  <Formats lang={lang} />
  <HowToOrder lang={lang} />
  <Faq lang={lang} />
  {/* MadeInSerbia removed 2026-10-29: printing moves to print on demand, shipping worldwide. */}
  <SocialFeed lang={lang} />
  <FinalCta lang={lang} />
</Base>
