---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Manifesto from './Manifesto.astro';
import Series from './Series.astro';
import Interiors from './Interiors.astro';
import Formats from './Formats.astro';
import HowToOrder from './HowToOrder.astro';
import Faq from './Faq.astro';
import FinalCta from './FinalCta.astro';
import About from './About.astro';
import MathArt from './MathArt.astro';
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang}>
  <Hero lang={lang} />
  <Series lang={lang} />
  <Manifesto lang={lang} />
  <MathArt lang={lang} />
  <About lang={lang} />
  <Interiors lang={lang} />
  <Formats lang={lang} />
  <HowToOrder lang={lang} />
  <Faq lang={lang} />
  {/* MadeInSerbia removed 2026-10-29: printing moves to print on demand, shipping worldwide. */}
  <FinalCta lang={lang} />
</Base>
