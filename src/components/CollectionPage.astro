---
import Base from '../layouts/Base.astro';
import ProductCard from './ProductCard.astro';
import SeriesHeader from './SeriesHeader.astro';
import SeriesMath from './SeriesMath.astro';
import History from './History.astro';
import { SERIES, PRODUCTS, productsBySeries } from '../data/products.js';
import { T, homeHref, collectionHref, seriesShort, type Lang } from '../i18n';
interface Props { lang: Lang; seriesSlug?: string }
const { lang, seriesSlug } = Astro.props;
const t = T[lang];
const current = SERIES.find((s) => s.slug === seriesSlug);
const shown = current ? [current] : SERIES;
const info = current ? t.series[current.key as 'structure'] : null;
const title = current ? `${seriesShort(lang, current.key)} - ${t.collection.title} | Резонанца` : `${t.collection.title} | Резонанца`;
const description = info ? info.desc : t.collection.lead;
---
<Base lang={lang} title={title} description={description}>
  <section class="top grid-bg">
    <div class="wrap">
      <nav class="crumbs mono" aria-label="Breadcrumb">
        <a href={homeHref(lang)}>{t.product.home}</a><span>/</span>
        {current ? <><a href={collectionHref(lang)}>{t.collection.title}</a><span>/</span><span aria-current="page">{seriesShort(lang, current.key)}</span></>
                 : <span aria-current="page">{t.collection.title}</span>}
      </nav>
      <p class="label">{current ? info!.code : t.collection.label}</p>
      <h1>{current ? info!.name : t.collection.title}</h1>
      <p class="lead">{current ? info!.desc : t.collection.lead}</p>

      <div class="chips mono" role="list">
        <a role="listitem" href={collectionHref(lang)} class:list={{ on: !current }}>{t.collection.all} <i>{PRODUCTS.length}</i></a>
        {SERIES.map((s) => (
          <a role="listitem" href={collectionHref(lang, s.slug)} class:list={{ on: current?.slug === s.slug }}>
            {seriesShort(lang, s.key)} <i>{productsBySeries(s.key).length}</i>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="list">
    <div class="wrap">
      {shown.map((s, si) => (
        <div class="series">
          {!current && <SeriesHeader lang={lang} series={s} />}
          <div class:list={['grid', { rail: !current }]}>
            {productsBySeries(s.key).map((p, i) => <ProductCard product={p} lang={lang} eager={si === 0 && i < 3} delay={(i % 3) * 90} />)}
          </div>
        </div>
      ))}
    </div>
  </section>
  {current && <SeriesMath lang={lang} series={current.key} />}
  {current && <History lang={lang} series={current.key} />}
</Base>
<style>
  .top { padding: clamp(140px, 14vw, 200px) 0 var(--space-md); background-color: var(--bg-0); border-bottom: 1px solid var(--line); }
  .crumbs { display: flex; gap: 10px; flex-wrap: wrap; font-size: var(--fs-2xs); letter-spacing: var(--track-ui); text-transform: uppercase; color: var(--muted); margin-bottom: 36px; }
  .crumbs a:hover { color: var(--cyan); }
  .crumbs [aria-current] { color: var(--ice); }
  h1 { font-size: var(--fs-h1); line-height: 1.1; margin-top: 20px; }
  .lead { margin-top: 20px; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 40px; }
  .chips a { display: inline-flex; align-items: center; gap: 10px; padding: 11px 16px; border: 1px solid var(--line); font-size: var(--fs-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--text); transition: border-color 0.3s, color 0.3s, background 0.3s; }
  .chips a:hover { border-color: var(--line-strong); color: var(--ice); }
  .chips a.on { border-color: var(--cyan); background: rgba(80, 230, 255, 0.08); color: var(--cyan); }
  .chips i { font-style: normal; color: var(--muted); font-size: var(--fs-2xs); }
  .list { background: linear-gradient(var(--bg-0), var(--bg-1) 60%, var(--bg-0)); padding-top: var(--space-head); }
  .series + .series { margin-top: var(--space-block); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap-row) var(--gap-col); }
  @media (max-width: 860px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 420px) { .grid { gap: 20px 12px; } }
</style>
