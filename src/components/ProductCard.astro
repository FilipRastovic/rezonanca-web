---
import { PRICES, formatPrice } from '../config';
import { pad } from '../data/products.js';
import { T, productHref, seriesShort, type Lang } from '../i18n';
interface Props { product: any; lang: Lang; eager?: boolean; delay?: number }
const { product: p, lang, eager = false, delay = 0 } = Astro.props;
const t = T[lang];
const series = t.series[p.style as 'structure'];
---
<a class="card" href={productHref(lang, p.slug)} data-reveal style={`transition-delay:${delay}ms`}>
  <span class="top mono">
    <span>{seriesShort(lang, p.style)}</span>
    <span>{t.product.no} {pad(p.seed)}</span>
  </span>
  <span class="stage">
    <span class="art">
      <img src={`/posters/${p.slug}-${lang}.webp`} alt={`${series.name} - ${p.name[lang]}`} width="900" height="1200" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </span>
  </span>
  <span class="info">
    <span class="name">{p.name[lang]}</span>
    <span class="variant mono">{t.variants[p.variant as 'burst']} · {t.palettes[p.palette as 'cyan']}</span>
  </span>
  <span class="foot">
    <span class="price"><span class="mono">{t.card.from}</span> {formatPrice(PRICES.print['30x40'], lang)}</span>
    <span class="go mono">{t.card.view} <span class="arrow">→</span></span>
  </span>
</a>
<style>
  .card { display: flex; flex-direction: column; color: inherit; border: 1px solid var(--line); background: rgba(3, 8, 20, 0.6); transition: border-color 0.4s, box-shadow 0.4s, transform 0.4s; }
  .card:hover { border-color: var(--line-strong); box-shadow: var(--glow); transform: translateY(-4px); }
  .top { display: flex; justify-content: space-between; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--line); font-size: var(--fs-2xs); letter-spacing: var(--track-ui); text-transform: uppercase; color: var(--muted); }
  .top span:first-child { color: var(--cyan); }
  /* The framed print, sitting on a dark "wall". */
  .stage { display: block; padding: clamp(18px, 2.2vw, 30px); background: radial-gradient(ellipse at 50% 45%, rgba(35, 105, 255, 0.10), transparent 70%); }
  .art { position: relative; display: block; padding: var(--mat-pad); background: var(--mat); border: 6px solid var(--frame); box-shadow: var(--frame-shadow); }
  .art::after { content: ''; position: absolute; inset: var(--mat-pad); box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.35); pointer-events: none; }
  .art img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; transition: filter 0.6s; }
  .card:hover .art img { filter: brightness(1.1) saturate(1.08); }
  .info { display: flex; flex-direction: column; gap: 6px; padding: 16px 16px 14px; border-top: 1px solid var(--line); }
  .name { font: 500 var(--fs-h3)/1.25 var(--f-display); color: var(--ice); }
  .variant { font-size: var(--fs-2xs); letter-spacing: var(--track-ui); text-transform: uppercase; color: var(--muted); }
  .foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: auto; padding: 14px 16px; border-top: 1px solid var(--line); }
  .price { font: 500 var(--fs-body)/1 var(--f-body); color: var(--ice); }
  .price .mono { font-size: var(--fs-2xs); color: var(--muted); letter-spacing: 0.1em; text-transform: uppercase; margin-right: 4px; }
  .go { font-size: var(--fs-2xs); letter-spacing: var(--track-ui); text-transform: uppercase; color: var(--cyan); }
  .go .arrow { display: inline-block; transition: transform 0.3s; }
  .card:hover .go .arrow { transform: translateX(4px); }
  @media (hover: none) { .card:hover { transform: none; box-shadow: none; border-color: var(--line); } .card:hover .art img { filter: none; } }
</style>
