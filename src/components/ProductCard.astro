---
import { MIN_PRICE, PRICES_VISIBLE, formatPrice } from '../config';
import { pad } from '../data/products.js';
import { T, productHref, seriesShort, type Lang } from '../i18n';
interface Props { product: any; lang: Lang; eager?: boolean; delay?: number; tone?: string }
const { product: p, lang, eager = false, delay = 0, tone: show = '' } = Astro.props;
const t = T[lang];
const series = t.series[p.style as 'structure'];
const tone = p.tones?.[0]; // first colourway: shown as colour dots
const PAL_GLOW: Record<string, string> = { cyan: '#2a8cff', ice: '#8fa6c8', violet: '#7a4dff', aurora: '#11c9a8', ember: '#ff9a4a' };
---
<a class="card" href={productHref(lang, p.slug) + (show ? `?boja=${show}` : '')} data-reveal style={`transition-delay:${delay}ms`}>
  <span class="top mono">
    <span>{seriesShort(lang, p.style)}</span>
    <span>{t.product.no} {pad(p.seed)}</span>
  </span>
  <span class="stage">
    <span class="art">
      <img src={`/posters/${p.slug}${show ? `-${show}` : ''}-${lang}.webp`} alt={`${series.name} - ${p.name[lang]}${show ? ` (${t.order.tones[show as 'orig']})` : ''}`} width="900" height="1200" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </span>
    <img class="room" src={`/rooms/${p.slug}${show ? `-${show}` : ''}-${lang}-sm.webp`} alt="" width="540" height="720" loading="lazy" decoding="async" />
  </span>
  <span class="info">
    <span class="name">{p.name[lang]}{show && <small class="mono">{t.order.tones[show as 'orig']}</small>}</span>
    {tone && (
      <span class="tones" title={['orig', ...p.tones].map((k: string) => t.order.tones[k as 'orig']).join(' · ')}>
        <i style={`background:linear-gradient(135deg,#050b1e 50%,${PAL_GLOW[p.palette] || '#2a8cff'} 50%)`}></i>
        <i style="background:linear-gradient(135deg,#b23a68 50%,#0fb37d 50%)"></i>
      </span>
    )}
  </span>
  <span class="foot">
    {PRICES_VISIBLE ? <span class="price"><span class="mono">{t.card.from}</span> {formatPrice(MIN_PRICE, lang)}</span>
               : <span class="soon mono">{t.soon.badge}</span>}
    <span class="go mono">{t.card.view} <span class="arrow">→</span></span>
  </span>
</a>
<style>
  .card { display: flex; flex-direction: column; color: inherit; border: 1px solid var(--line); background: rgba(3, 8, 20, 0.6); transition: border-color 0.4s, box-shadow 0.4s, transform 0.4s; }
  .card:hover { border-color: var(--line-strong); box-shadow: var(--glow); transform: translateY(-4px); }
  .top { display: flex; justify-content: space-between; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--line); font-size: var(--fs-2xs); letter-spacing: var(--track-ui); text-transform: uppercase; color: var(--muted); }
  .top span:first-child { color: var(--cyan); }
  /* The framed print, sitting on a dark "wall". */
  /* A slightly lit 'wall' so the frame's shadow reads. */
  .stage { display: block; padding: clamp(22px, 2.6vw, 34px) clamp(22px, 2.6vw, 34px) clamp(30px, 3.4vw, 44px); background: radial-gradient(ellipse at 35% 25%, rgba(70, 110, 170, 0.22), transparent 65%), linear-gradient(160deg, #111b2e, #0a1222 60%, #070d1a); }
  .art { position: relative; display: block; padding: var(--mat-pad); background: var(--mat); border: 6px solid var(--frame); box-shadow: var(--frame-shadow), inset 0 0 0 1px rgba(255, 255, 255, 0.06); transition: transform 0.4s, box-shadow 0.4s; }
  .card:hover .art { transform: translate(-2px, -3px); box-shadow: 0 1px 1px rgba(0,0,0,.7), 3px 6px 8px rgba(0,0,0,.55), 12px 22px 30px -4px rgba(0,0,0,.8), 26px 48px 70px -16px rgba(0,0,0,.95); }
  .art::after { content: ''; position: absolute; inset: var(--mat-pad); box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.35); pointer-events: none; }
  .art img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; transition: filter 0.6s; }
  /* Hover: swap to the same print hanging in a room. Touch screens keep the print. */
  .stage { position: relative; overflow: hidden; }
  .room { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; opacity: 0; transition: opacity 0.5s; pointer-events: none; }
  @media (hover: hover) { .card:hover .room { opacity: 1; } }
  @media (hover: none) { .room { display: none; } }
  .card:hover .art img { filter: brightness(1.1) saturate(1.08); }
  .info { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 16px 14px; border-top: 1px solid var(--line); }
  .tones { display: flex; gap: 5px; flex: none; }
  .tones i { width: 12px; height: 12px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.3); }
  .name { font: 500 var(--fs-h3)/1.25 var(--f-display); color: var(--ice); }
  .name small { margin-left: 10px; font-size: var(--fs-2xs); letter-spacing: var(--track-ui); text-transform: uppercase; color: #e07aa0; vertical-align: middle; }
  .foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: auto; padding: 14px 16px; border-top: 1px solid var(--line); }
  .price { font: 500 var(--fs-body)/1 var(--f-body); color: var(--ice); }
  .price .mono { font-size: var(--fs-2xs); color: var(--muted); letter-spacing: 0.1em; text-transform: uppercase; margin-right: 4px; }
  .soon { padding: 4px 9px; border: 1px solid var(--line-strong); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ice); }
  .go { font-size: var(--fs-2xs); letter-spacing: var(--track-ui); text-transform: uppercase; color: var(--cyan); }
  .go .arrow { display: inline-block; transition: transform 0.3s; }
  .card:hover .go .arrow { transform: translateX(4px); }
  @media (hover: none) { .card:hover { transform: none; box-shadow: none; border-color: var(--line); } .card:hover .art img { filter: none; } }
</style>
