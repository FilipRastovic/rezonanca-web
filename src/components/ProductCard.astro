---
import { PRICES_VISIBLE, minPrice, formatPrice } from '../config';
import SWATCHES from '../data/swatches.json';
import { T, productHref, seriesShort, type Lang } from '../i18n';
interface Props { product: any; lang: Lang; eager?: boolean; delay?: number; tone?: string }
const { product: p, lang, eager = false, delay = 0, tone: show = '' } = Astro.props;
const t = T[lang];
const series = t.series[p.style as 'structure'];
const key = `${p.slug}${show ? `-${show}` : ''}`;
const tone = p.tones?.[0]; // first colourway: shown as colour dots
// One dot per colour version, in that poster's dominant colour (scripts/swatches.mjs).
const SW = SWATCHES as Record<string, string>;
---
<a class="card" href={productHref(lang, p.slug) + (show ? `?boja=${show}` : '')} data-reveal style={`transition-delay:${delay}ms`}>
  <span class="stage">
    <img class="room" src={`/rooms/${key}-${lang}-sm.webp`} srcset={`/rooms/${key}-${lang}-sm.webp 540w, /rooms/${key}-${lang}.webp 960w`} sizes="(max-width: 600px) 100vw, 360px" alt={`${series.name} - ${p.name[lang]}${show ? ` (${t.order.tones[show as 'orig']})` : ''}`} width="540" height="720" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    <span class="art">
      <img src={`/posters/${key}-${lang}.webp`} alt="" width="900" height="1200" loading="lazy" decoding="async" />
    </span>
  </span>
  <span class="info">
    <span class="row">
      <span class="name">{p.name[lang]}{show && <small>{t.order.tones[show as 'orig']}</small>}</span>
      {tone && (
        <span class="tones" title={['orig', ...p.tones].map((k: string) => t.order.tones[k as 'orig']).join(' · ')}>
          {['', ...p.tones].map((tn: string) => <i style={`background:${SW[tn ? `${p.slug}-${tn}` : p.slug]}`}></i>)}
        </span>
      )}
    </span>
    <span class="meta">
      <span>{seriesShort(lang, p.style)}</span>
      {PRICES_VISIBLE ? <span class="price">{t.card.from} {formatPrice(minPrice('print'), lang)}</span> : <span>{t.soon.badge}</span>}
    </span>
  </span>
</a>
<style>
  /* Minimal gallery card: image, then name + colour dots, then series and price. No borders, no bars. */
  .card { display: flex; flex-direction: column; color: inherit; }
  /* Card image: the print hanging in a room. Hover (desktop): the plain print on a light wall, exactly as shipped. */
  .stage { position: relative; display: block; aspect-ratio: 3 / 4; overflow: hidden; background: linear-gradient(160deg, #f3f1ec, #eeebe5 60%, #e9e6df); }
  .room { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity 0.45s, transform 0.9s cubic-bezier(.2,.7,.2,1); }
  .art { position: absolute; left: 50%; top: 47%; width: 70%; transform: translate(-50%, -50%); padding: var(--mat-pad); background: var(--mat); border: 6px solid var(--frame); box-shadow: var(--frame-shadow); opacity: 0; transition: opacity 0.45s; }
  .art img { display: block; width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
  @media (hover: hover) {
    .card:hover .room { opacity: 0; }
    .card:hover .art { opacity: 1; }
  }
  @media (hover: none) { .art { display: none; } }
  .info { display: grid; gap: 6px; padding: 16px 0 0; }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .name { font: 500 var(--fs-h3)/1.25 var(--f-display); color: var(--ice); }
  .name small { margin-left: 8px; font: 400 var(--fs-2xs)/1 var(--f-body); letter-spacing: var(--track-ui); text-transform: uppercase; color: #b23a68; vertical-align: middle; }
  .card:hover .name { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .tones { display: flex; gap: 5px; flex: none; }
  .tones i { width: 10px; height: 10px; border-radius: 50%; border: 1px solid rgba(18, 20, 23, 0.12); }
  .meta { display: flex; justify-content: space-between; gap: 12px; font-size: var(--fs-sm); color: var(--muted); }
  @media (max-width: 600px) {
    .name { font-size: var(--fs-sm); }
    .meta { flex-direction: column; gap: 2px; font-size: var(--fs-2xs); }
    .tones i { width: 8px; height: 8px; }
  }
  .price { color: var(--ice); }
</style>
