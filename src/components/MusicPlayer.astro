---
// Background music (royalty-free Pixabay track). Starts on its own where the browser allows it,
// otherwise on the visitor's first tap or key. Off is remembered (localStorage 'rz-music' = 'off');
// the play position carries over between pages (sessionStorage 'rz-music-t').
---
<div class="music" data-music>
  <audio src="/audio/neon-drive.mp3" preload="none" loop></audio>
  <button type="button" class="mbtn" aria-label="Music" aria-pressed="false" title="Music">
    <span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  </button>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-music]')!;
  const audio = root.querySelector('audio')!;
  const btn = root.querySelector('button')!;
  const VOL = 0.35;
  const get = (s: Storage, k: string) => { try { return s.getItem(k); } catch { return null; } };
  const set = (s: Storage, k: string, v: string) => { try { s.setItem(k, v); } catch { /* storage blocked */ } };

  let wanted = get(localStorage, 'rz-music') !== 'off';
  const show = () => { const on = !audio.paused; root.classList.toggle('on', on); btn.setAttribute('aria-pressed', String(on)); };
  audio.addEventListener('play', show);
  audio.addEventListener('pause', show);

  const fadeIn = () => {
    audio.volume = 0;
    const id = setInterval(() => { audio.volume = Math.min(VOL, audio.volume + 0.02); if (audio.volume >= VOL) clearInterval(id); }, 60);
  };
  const start = () => {
    audio.preload = 'auto';
    const t = +(get(sessionStorage, 'rz-music-t') || 0);
    if (t && !audio.currentTime) audio.currentTime = t;
    fadeIn();
    return audio.play();
  };

  // Browsers block sound until the visitor interacts, so retry on the first tap or key.
  const unlock = (e: Event) => {
    if (root.contains(e.target as Node)) return; // the button handles itself
    off();
    if (wanted && audio.paused) start().catch(() => {});
  };
  const off = () => ['pointerdown', 'keydown', 'touchend'].forEach((n) => removeEventListener(n, unlock, true));

  if (wanted) start().catch(() => ['pointerdown', 'keydown', 'touchend'].forEach((n) => addEventListener(n, unlock, true)));

  btn.addEventListener('click', () => {
    off();
    if (audio.paused) { wanted = true; set(localStorage, 'rz-music', 'on'); start().catch(() => {}); }
    else { wanted = false; set(localStorage, 'rz-music', 'off'); audio.pause(); }
  });

  const save = () => { if (!audio.paused) set(sessionStorage, 'rz-music-t', String(audio.currentTime)); };
  setInterval(save, 2000);
  addEventListener('pagehide', save);
</script>

<style>
  .music { position: fixed; z-index: 80; left: max(16px, env(safe-area-inset-left, 0px)); bottom: calc(16px + env(safe-area-inset-bottom, 0px)); }
  .mbtn { width: 42px; height: 42px; display: grid; place-items: center; padding: 0; border-radius: 50%; border: 1px solid var(--line-strong); background: rgba(251, 250, 247, 0.9); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); color: var(--blue); cursor: pointer; transition: border-color 0.2s; }
  .mbtn:hover { border-color: var(--blue); }
  .bars { display: flex; align-items: flex-end; gap: 2.5px; height: 14px; }
  .bars i { width: 2.5px; height: 4px; background: currentColor; border-radius: 1px; }
  .on .bars i { animation: eq 0.9s ease-in-out infinite alternate; }
  .on .bars i:nth-child(2) { animation-delay: -0.3s; animation-duration: 0.7s; }
  .on .bars i:nth-child(3) { animation-delay: -0.6s; animation-duration: 1.1s; }
  .on .bars i:nth-child(4) { animation-delay: -0.15s; animation-duration: 0.8s; }
  /* Off: a flat line with a slash through it. */
  .music:not(.on) .bars { position: relative; }
  .music:not(.on) .bars::after { content: ''; position: absolute; left: -3px; right: -3px; top: 50%; height: 1.5px; background: currentColor; transform: rotate(-45deg); }
  @keyframes eq { from { height: 3px; } to { height: 14px; } }
  @media (prefers-reduced-motion: reduce) { .on .bars i { animation: none; height: 10px; } }
</style>
