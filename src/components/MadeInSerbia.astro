---
import { SERBIA_MAP } from '../data/serbia-map';
import { T, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang].madeIn;
// Split the map so the Novi Sad marker can be highlighted.
const [before, after] = SERBIA_MAP.split('@');
---
<section class="made grid-bg">
  <div class="wrap">
    <div class="box panel">
      <div class="text">
        <p class="label" data-reveal>{t.label}</p>
        <h2 data-reveal>{t.title}</h2>
        <p class="lead" data-reveal>{t.lead}</p>
        <ol class="steps">
          {t.steps.map((s, i) => (
            <li data-reveal style={`transition-delay:${i * 100}ms`}>
              <span class="k mono">0{i + 1} // {s.k}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
      <figure class="map" data-reveal aria-label={lang === 'sr' ? 'Мапа Србије' : 'Map of Serbia'}>
        <pre aria-hidden="true">{before}<span class="pin">@</span>{after}</pre>
        <figcaption class="mono"><span class="dot"></span>{t.pin} · {t.coords}</figcaption>
      </figure>
    </div>
  </div>
</section>
<style>
  .made { background-color: var(--bg-0); }
  .box { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 5vw, 80px); align-items: center; }
  .lead { margin-top: 20px; }
  .steps { list-style: none; padding: 0; margin: 36px 0 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .steps li { padding: 20px 0; border-bottom: 1px solid var(--line); }
  .k { font-size: var(--fs-2xs); letter-spacing: var(--track-label); color: var(--cyan); }
  .steps h3 { margin-top: 10px; }
  .steps p { margin: 6px 0 0; color: var(--muted); font-size: var(--fs-sm); }
  .map { margin: 0; display: flex; flex-direction: column; align-items: center; }
  pre { margin: 0; font: 400 clamp(8px, 1.05vw, 15px)/1 var(--f-mono); color: rgba(80, 230, 255, 0.55); text-shadow: 0 0 8px rgba(80, 230, 255, 0.35); white-space: pre; letter-spacing: 0; }
  .pin { color: var(--ice); font-weight: 700; text-shadow: 0 0 6px var(--cyan), 0 0 18px var(--cyan); animation: pin 1.6s infinite; }
  @keyframes pin { 50% { opacity: 0.35; } }
  figcaption { margin-top: 18px; display: flex; align-items: center; gap: 10px; font-size: var(--fs-2xs); letter-spacing: var(--track-ui); color: var(--ice); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 10px var(--cyan); }
  @media (max-width: 900px) { .box { grid-template-columns: 1fr; } .map { order: -1; } pre { font-size: clamp(6px, 2.1vw, 11px); } }
  @media (prefers-reduced-motion: reduce) { .pin { animation: none; } }
</style>
