---
import { PRODUCTS, SERIES, pad } from '../data/products.js';
import { SHOP, SIZES, FORMATS, FRAMES, PRICES } from '../config';
import { T, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang].order;
const f = T[lang].formats.items;
const s = T[lang].series;
const groups = SERIES.map(({ key }) => ({ label: s[key as 'structure'].name, items: PRODUCTS.filter((p) => p.style === key) }));
const cfg = JSON.stringify({ prices: PRICES, key: SHOP.web3formsKey, email: SHOP.email, lang, shop: SHOP.name });
---
<dialog id="order" class="modal" aria-labelledby="order-title">
  <form class="sheet corners" novalidate data-config={cfg}>
    <header>
      <div>
        <p class="label">{t.label}</p>
        <h2 id="order-title">{t.title}</h2>
      </div>
      <button type="button" class="x" data-close aria-label={t.close}>✕</button>
    </header>

    <div class="body">
      <div class="preview">
        <img id="order-img" src={`/posters/${PRODUCTS[0].slug}-${lang}.webp`} alt="" width="900" height="1200" />
        <div class="total">
          <span class="mono">{t.total}</span>
          <strong id="order-total">-</strong>
          <small>{t.totalNote}</small>
        </div>
      </div>

      <div class="fields">
        <label class="full">{t.poster}
          <select name="poster" required>
            {groups.map((g) => (
              <optgroup label={g.label}>
                {g.items.map((p) => (
                  <option value={p.slug} data-img={`/posters/${p.slug}-${lang}.webp`}>
                    {p.name[lang]} - {pad(p.seed)}
                  </option>
                ))}
              </optgroup>
            ))}
            <option value="custom">{t.custom}</option>
          </select>
        </label>
        <label>{t.format}
          <select name="format">{FORMATS.map((k) => <option value={k}>{f[k].t}</option>)}</select>
        </label>
        <label>{t.size}
          <select name="size">{SIZES.map((s) => <option value={s}>{s.replace('x', ' × ')} cm</option>)}</select>
        </label>
        <label data-frame>{t.frame}
          <select name="frame">{FRAMES.map((k) => <option value={k}>{t.frames[k]}</option>)}</select>
        </label>
        <label>{t.qty}
          <input name="qty" type="number" min="1" max="20" value="1" inputmode="numeric" />
        </label>

        <label class="full">{t.name}<input name="name" required autocomplete="name" /></label>
        <label>{t.phone}<input name="phone" type="tel" required autocomplete="tel" /></label>
        <label>{t.email}<input name="email" type="email" required autocomplete="email" /></label>
        <label class="full">{t.address}<input name="address" required autocomplete="street-address" /></label>
        <label>{t.city}<input name="city" required autocomplete="address-level2" /></label>
        <label>{t.zip}<input name="zip" required autocomplete="postal-code" inputmode="numeric" /></label>
        <label class="full">{t.note}<textarea name="note" rows="2"></textarea></label>

        <fieldset class="full">
          <legend>{t.payment}</legend>
          <label class="radio"><input type="radio" name="payment" value="cod" checked /> {t.payments.cod}</label>
          <label class="radio"><input type="radio" name="payment" value="bank" /> {t.payments.bank}</label>
        </fieldset>
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <p class="status full" role="status" aria-live="polite"></p>
        <button class="btn btn--solid submit full" type="submit" data-label={t.submit} data-sending={t.sending}>{t.submit} <span class="arrow">→</span></button>
      </div>
    </div>
  </form>
  <template id="order-msgs" data-success={t.success} data-demo={t.demo} data-error={t.error} data-required={t.required}></template>
</dialog>

<script>
  import { initOrder } from '../scripts/order';
  initOrder(document.getElementById('order') as HTMLDialogElement);
</script>

<style>
  .modal { width: min(980px, calc(100vw - 24px)); max-height: calc(100dvh - 24px); overflow-y: auto; overscroll-behavior: contain; padding: 0; border: none; background: transparent; color: var(--text); }
  .modal::backdrop { background: rgba(1, 3, 10, 0.8); backdrop-filter: blur(8px); }
  .modal[open] { animation: open 0.4s cubic-bezier(0.2, 0.7, 0.2, 1); }
  @keyframes open { from { opacity: 0; transform: translateY(20px) scale(0.98); } }
  .sheet { background-color: var(--bg-card); border: 1px solid var(--line-strong); padding: clamp(20px, 3vw, 36px); box-shadow: var(--glow); }
  header { display: flex; justify-content: space-between; align-items: start; gap: 20px; margin-bottom: 28px; }
  header h2 { font-size: var(--fs-h2); margin-top: 12px; }
  .x { background: none; border: 1px solid var(--line); width: 40px; height: 40px; cursor: pointer; color: var(--ice); flex: none; }
  .x:hover { border-color: var(--cyan); color: var(--cyan); }
  .body { display: grid; grid-template-columns: 240px 1fr; gap: 32px; }
  .preview img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border: 1px solid var(--line); }
  .total { margin-top: 20px; display: flex; flex-direction: column; gap: 6px; }
  .total .mono { font-size: var(--fs-2xs); color: var(--muted); letter-spacing: var(--track-label); text-transform: uppercase; }
  .total strong { font: 500 var(--fs-price)/1 var(--f-display); color: var(--ice); }
  .total small { color: var(--muted); font-size: var(--fs-sm); }
  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 18px; align-content: start; }
  .full { grid-column: 1 / -1; }
  label, legend { display: flex; flex-direction: column; gap: 8px; font: 500 var(--fs-xs)/1 var(--f-mono); letter-spacing: var(--track-ui); text-transform: uppercase; color: var(--muted); }
  input, select, textarea { width: 100%; padding: 13px 14px; background: rgba(1, 3, 10, 0.8); border: 1px solid var(--line); color: var(--ice); font: 400 16px/1.3 var(--f-body); letter-spacing: 0; text-transform: none; border-radius: 0; transition: border-color 0.3s, box-shadow 0.3s; }
  select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--cyan) 50%), linear-gradient(-45deg, transparent 50%, var(--cyan) 50%); background-position: right 18px center, right 13px center; background-size: 5px 5px; background-repeat: no-repeat; padding-right: 36px; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(80, 230, 255, 0.12); }
  [aria-invalid='true'] { border-color: #ff5f7a; }
  fieldset { border: none; padding: 0; margin: 0; display: flex; gap: 24px; flex-wrap: wrap; }
  legend { margin-bottom: 10px; }
  .radio { flex-direction: row; align-items: center; gap: 10px; font: 400 var(--fs-body)/1 var(--f-body); letter-spacing: 0; text-transform: none; color: var(--ice); cursor: pointer; }
  .radio input { width: 18px; height: 18px; accent-color: var(--cyan); }
  .hp { display: none; }
  .status { margin: 0; min-height: 1.2em; font-size: var(--fs-body); color: var(--cyan); }
  .status.err { color: #ff8da0; }
  .submit { justify-content: center; padding: 18px; }
  .submit[disabled] { opacity: 0.6; cursor: wait; }
  [data-frame][hidden] { display: none; }
  @media (max-width: 760px) {
    .body { grid-template-columns: 1fr; }
    .preview { display: grid; grid-template-columns: 110px 1fr; gap: 16px; align-items: end; }
    .total { margin: 0; }
  }
  @media (max-width: 480px) { .fields { grid-template-columns: 1fr; } }
</style>
