---
import { T, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang].interiors;
const scenes = (['living', 'studio', 'hall'] as const).map((k) => ({ k, ...t.scenes[k] }));
---
<section id="interiors" class="grid-bg">
  <div class="wrap">
    <div class="section-head">
      <p class="label" data-reveal>{t.label}</p>
      <h2 data-reveal>{t.title}</h2>
      <p class="lead" data-reveal>{t.lead}</p>
    </div>
    <div class="scenes">
      {scenes.map((s, i) => (
        <figure class:list={['scene', { wide: i === 0 }]} data-reveal>
          <img src={`/interiors/${s.k}-${lang}.webp`} alt={`${s.t} - ${s.d}`} width="1600" height="1000" loading="lazy" decoding="async" />
          <figcaption>
            <span class="mono">0{i + 1}</span>
            <strong>{s.t}</strong>
            <span>{s.d}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
<style>
  section { background-color: var(--bg-0); }
  .scenes { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(16px, 2.4vw, 32px); }
  .scene { position: relative; margin: 0; overflow: hidden; border: 1px solid var(--line); }
  .scene.wide { grid-column: 1 / -1; }
  .scene img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; transition: transform 1.6s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .scene.wide img { aspect-ratio: 16 / 8; }
  .scene:hover img { transform: scale(1.03); }
  figcaption { position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; padding: 48px 24px 20px; background: linear-gradient(transparent, rgba(1, 3, 10, 0.9)); }
  figcaption .mono { font-size: var(--fs-2xs); color: var(--cyan); }
  figcaption strong { font: 500 var(--fs-h3)/1.2 var(--f-display); color: var(--ice); }
  figcaption span:last-child { color: var(--muted); font-size: var(--fs-body); }
  @media (max-width: 760px) { .scenes { grid-template-columns: 1fr; } .scene.wide img { aspect-ratio: 16 / 10; } figcaption { position: static; padding: 14px 4px 0; background: none; } }
</style>
