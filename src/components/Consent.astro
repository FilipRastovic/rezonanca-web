---
// Cookie banner + analytics loader. Meta Pixel / GA4 load only after "accept"; the choice is kept in
// localStorage ('rz-consent' = 'yes' | 'no'). Pages report events with window.rzTrack(name, params):
// they are queued until consent and dropped on "decline". The footer "Cookies" link reopens the banner.
import { ANALYTICS } from '../config';
import { T, legalHref, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang].consent;
const on = !!(ANALYTICS.metaPixel || ANALYTICS.ga4);
---
{on && (
  <>
    <script is:inline define:vars={{ px: ANALYTICS.metaPixel, ga: ANALYTICS.ga4 }}>
      (function () {
        var w = window, q = [], loaded = false;
        var get = function () { try { return localStorage.getItem('rz-consent'); } catch (e) { return null; } };
        var send = function (name, params) {
          if (w.fbq) w.fbq('track', name, params || {});
          if (w.gtag) w.gtag('event', { PageView: 'page_view', ViewContent: 'view_item', Lead: 'generate_lead', AddToCart: 'add_to_cart', Purchase: 'purchase' }[name] || name, params || {});
        };
        w.rzLoad = function () {
          if (loaded) return; loaded = true;
          if (px) {
            !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(w,document,'script','https://connect.facebook.net/en_US/fbevents.js');
            w.fbq('init', px); w.fbq('track', 'PageView');
          }
          if (ga) {
            var s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga; document.head.appendChild(s);
            w.dataLayer = w.dataLayer || []; w.gtag = function () { w.dataLayer.push(arguments); };
            w.gtag('js', new Date()); w.gtag('config', ga);
          }
          q.splice(0).forEach(function (e) { send(e[0], e[1]); });
        };
        w.rzTrack = function (name, params) {
          var c = get();
          if (c === 'yes') { w.rzLoad(); send(name, params); } else if (c !== 'no') q.push([name, params]);
        };
        if (get() === 'yes') w.rzLoad();
      })();
    </script>
    <div class="consent mono" id="consent" hidden role="dialog" aria-live="polite" aria-label={t.settings}>
      <p>{t.text} <a href={legalHref(lang, 'privacy')}>{t.more}</a></p>
      <div class="acts">
        <button type="button" class="btn" data-consent="no">{t.reject}</button>
        <button type="button" class="btn btn--solid" data-consent="yes">{t.accept}</button>
      </div>
    </div>
    <script is:inline>
      (function () {
        var box = document.getElementById('consent');
        var c = null; try { c = localStorage.getItem('rz-consent'); } catch (e) {}
        if (!c) box.hidden = false;
        box.addEventListener('click', function (e) {
          var b = e.target.closest('[data-consent]'); if (!b) return;
          var v = b.dataset.consent, prev = null;
          try { prev = localStorage.getItem('rz-consent'); localStorage.setItem('rz-consent', v); } catch (e) {}
          box.hidden = true;
          if (v === 'yes') window.rzLoad();
          else if (prev === 'yes') location.reload(); // withdraw: reload so nothing stays loaded
        });
        document.addEventListener('click', function (e) {
          if (e.target.closest('[data-consent-open]')) { e.preventDefault(); box.hidden = false; }
        });
      })();
    </script>
  </>
)}
<style>
  .consent { position: fixed; z-index: 90; left: 16px; right: 16px; bottom: 16px; max-width: 560px; margin-inline: auto; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 20px; padding: 16px 18px; background: rgba(3, 8, 20, 0.96); border: 1px solid var(--line-strong); box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6); backdrop-filter: blur(10px); }
  .consent[hidden] { display: none; }
  .consent p { flex: 1 1 260px; margin: 0; font-size: var(--fs-2xs); line-height: 1.6; letter-spacing: 0.04em; color: var(--text); }
  .consent a { color: var(--cyan); text-decoration: underline; text-underline-offset: 3px; }
  .acts { display: flex; gap: 10px; }
  .acts .btn { padding: 10px 16px; font-size: var(--fs-2xs); }
</style>
