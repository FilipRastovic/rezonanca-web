---
import Logo from './Logo.astro';
import { SHOP, SELLER } from '../config';
import PaymentLogos from './PaymentLogos.astro';
import { SERIES } from '../data/products.js';
import { GUIDES } from '../data/guides';
import { T, collectionHref, seriesShort, legalHref, guideHref, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang].footer;
// Waveform strip (decorative, like the strip on the posters): fixed bar heights, CSS breathes them.
const BARS = Array.from({ length: 140 }, (_, i) => Math.round(20 + 80 * Math.abs(Math.sin(i * 0.37) * Math.cos(i * 0.11))));
---
<footer>
  <div class="wrap sig" aria-hidden="true">
    <div class="wave">{BARS.map((h, i) => <i style={`height:${h}%;animation-delay:-${(i * 37) % 240 / 100}s`} />)}</div>
    <p class="big">REZONANCA</p>
  </div>
  <div class="wrap grid">
    <div>
      <Logo size={18} tag={lang === 'sr' ? 'принтови нацртани кодом · Нови Сад' : 'prints drawn in code · Novi Sad'} />
      <p>{t.tagline}</p>
    </div>
    <div class="contact mono">
      <span class="k">{T[lang].nav.collection}</span>
      <a href={collectionHref(lang)}>{T[lang].collection.all}</a>
      {SERIES.map((s) => <a href={collectionHref(lang, s.slug)}>{seriesShort(lang, s.key)}</a>)}
    </div>
    <div class="contact mono">
      <span class="k">{T[lang].guide.title}</span>
      {GUIDES.map((g) => <a href={guideHref(g.slug)}>{g.h1}</a>)}
      {lang === 'en' && <a href="/wallpapers/">Free wallpapers</a>}
      {lang === 'en' && <a href="/play/">Play with the equation</a>}
      {lang === 'en' && <a href="/about/">About me</a>}
    </div>
    <div class="contact mono">
      <span class="k">{t.contact}</span>
      <a href={`mailto:${SHOP.email}`}>{SHOP.email}</a>
      <a href={`tel:${SHOP.phone.replace(/\s/g, '')}`}>{SHOP.phone}</a>
      {SHOP.instagram && <a href={SHOP.instagram} rel="noopener" target="_blank">Instagram ↗</a>}
      {SHOP.tiktok && <a href={SHOP.tiktok} rel="noopener" target="_blank">TikTok ↗</a>}
      {SHOP.facebook && <a href={SHOP.facebook} rel="noopener" target="_blank">Facebook ↗</a>}
      {SHOP.etsy && <a href={SHOP.etsy} rel="noopener" target="_blank">Etsy ↗</a>}
    </div>
  </div>
  <div class="wrap pay"><PaymentLogos /></div>
  <div class="wrap legal mono">
    <span>{SELLER.name} · {lang === 'sr' ? 'МБ' : 'Reg. no.'} {SELLER.mb} · {lang === 'sr' ? 'ПИБ' : 'Tax ID (PIB)'} {SELLER.pib}{SELLER.activity && ` · ${lang === 'sr' ? 'Делатност' : 'Activity'} ${SELLER.activity}`} · {SELLER.address}</span>
    <span class="links"><a href={legalHref(lang, 'terms')}>{T[lang].legal.terms.title}</a><a href={legalHref(lang, 'privacy')}>{T[lang].legal.privacy.title}</a><a href={legalHref(lang, 'privacy')} data-consent-open>{T[lang].consent.settings}</a></span>
  </div>
  <div class="wrap bottom mono">
    <span>© {new Date().getFullYear()} Rezonanca. {t.rights}</span>
    <span>{lang === 'sr' ? '45,2671°С 19,8335°И // НОВИ САД' : '45.2671°N 19.8335°E // NOVI SAD'}</span>
  </div>
</footer>
<style>
  .pay { padding-top: 28px; padding-bottom: 8px; }
  footer { border-top: 1px solid var(--line); padding: 48px 0 32px; background: var(--bg-1); }
  .sig { margin-bottom: 48px; }
  .wave { display: flex; gap: 3px; align-items: flex-end; height: 32px; overflow: hidden; }
  .wave i { flex: 1 0 2px; background: var(--cyan); opacity: 0.35; transform-origin: bottom; animation: rz-wave 2.4s ease-in-out infinite; }
  @keyframes rz-wave { 0%, 100% { transform: scaleY(0.3); } 50% { transform: scaleY(1); } }
  .sig .big { margin: 28px 0 0; font: 800 clamp(48px, 12.5vw, 184px)/0.85 var(--f-display); letter-spacing: -0.03em; color: transparent; -webkit-text-stroke: 1px var(--line-strong); white-space: nowrap; overflow: hidden; }
  @media (prefers-reduced-motion: reduce) { .wave i { animation: none; } }
  .grid { display: flex; justify-content: space-between; gap: 40px 64px; flex-wrap: wrap; }
  .grid > * { min-width: 0; max-width: 100%; }
  @media (max-width: 500px) { footer :global(.tag) { white-space: normal; line-height: 1.4; } footer :global(.logo) { align-items: flex-start; } }
  .grid > div:first-child { margin-right: auto; }
  p { color: var(--muted); margin: 16px 0 0; }
  .contact { display: flex; flex-direction: column; gap: 10px; font-size: var(--fs-sm); }
  .contact .k { color: var(--cyan); font-size: var(--fs-2xs); letter-spacing: var(--track-label); text-transform: uppercase; }
  .contact a:hover { color: var(--cyan); }
  .legal { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px 24px; margin-top: 56px; font-size: var(--fs-2xs); color: var(--muted); letter-spacing: 0.08em; }
  .legal .links { display: flex; gap: 20px; }
  .legal a:hover { color: var(--cyan); }
  .bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 20px; padding-top: 24px; border-top: 1px solid var(--line); font-size: var(--fs-2xs); color: var(--muted); letter-spacing: 0.14em; }
</style>
