---
import { FORMATS, PRICES, formatPrice } from '../config';
import { T, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang].formats;
---
<section id="formats">
  <div class="wrap">
    <div class="section-head">
      <p class="label" data-reveal>{t.label}</p>
      <h2 data-reveal>{t.title}</h2>
    </div>
    <div class="cards">
      {FORMATS.map((f, i) => {
        const item = t.items[f];
        return (
          <article class:list={['card', { featured: f === 'framed' }]} data-reveal style={`transition-delay:${i * 90}ms`}>
            {f === 'framed' && <span class="badge mono">{t.badge}</span>}
            <span class="idx mono">F-0{i + 1}</span>
            <h3>{item.t}</h3>
            <p class="d">{item.d}</p>
            <ul>{item.spec.map((s) => <li>{s}</li>)}</ul>
            <div class="price">
              <span class="mono">{t.from}</span>
              <strong>{formatPrice(PRICES[f]['30x40'], lang)}</strong>
            </div>
            <button class:list={['btn', { 'btn--solid': f === 'framed' }]} data-order data-format={f}>{T[lang].series.order} <span class="arrow">→</span></button>
          </article>
        );
      })}
    </div>

    <div class="get corners" data-reveal>
      <h3>{t.get.title}</h3>
      <ul>{t.get.items.map((g) => <li>{g}</li>)}</ul>
    </div>
  </div>
</section>
<style>
  section { background: linear-gradient(var(--bg-0), var(--bg-1)); }
  .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(14px, 1.8vw, 28px); }
  .card { position: relative; display: flex; flex-direction: column; padding: clamp(28px, 2.6vw, 40px) clamp(22px, 2vw, 32px); background: var(--bg-card); border: 1px solid var(--line); transition: border-color 0.4s, transform 0.4s, box-shadow 0.4s; }
  .card:hover { border-color: var(--line-strong); transform: translateY(-6px); }
  .card.featured { border-color: var(--cyan); box-shadow: var(--glow); background: linear-gradient(180deg, rgba(35, 105, 255, 0.14), var(--bg-card) 60%); }
  .badge { position: absolute; top: -11px; left: 24px; padding: 5px 10px; font-size: var(--fs-2xs); letter-spacing: var(--track-label); text-transform: uppercase; background: var(--cyan); color: var(--bg-0); font-weight: 700; }
  .idx { font-size: var(--fs-2xs); color: var(--muted); }
  h3 { margin-top: 18px; font-size: var(--fs-h3); }
  .d { margin: 12px 0 0; color: var(--text); font-size: var(--fs-body); min-height: 4.8em; }
  ul { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 10px; }
  li { position: relative; padding-left: 20px; font-size: var(--fs-sm); color: var(--muted); }
  li::before { content: ''; position: absolute; left: 0; top: 0.7em; width: 10px; height: 1px; background: var(--cyan); }
  .price { margin: auto 0 0; padding-top: 28px; display: flex; align-items: baseline; gap: 8px; }
  .price .mono { font-size: var(--fs-xs); color: var(--muted); }
  .price strong { font: 500 var(--fs-price)/1 var(--f-display); color: var(--ice); }
  .card .btn { margin-top: 20px; justify-content: center; }
  .get { margin-top: var(--space-block); padding: clamp(32px, 5vw, 72px); border: 1px solid var(--line); background-color: rgba(5, 12, 28, 0.7); display: grid; grid-template-columns: 1fr 2fr; gap: 32px; align-items: start; }
  .get h3 { font-size: var(--fs-h2); }
  .get ul { margin: 0; grid-template-columns: 1fr 1fr; gap: 14px 32px; }
  .get li { color: var(--text); font-size: var(--fs-body); }
  @media (max-width: 1080px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) { .get, .get ul { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .cards { grid-template-columns: 1fr; } .d { min-height: 0; } }
</style>
