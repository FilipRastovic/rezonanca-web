---
// A bare render in a journal article (public/journal/<article>/<key>-{900,1600}.webp), linked to its poster.
import { productHref } from '../i18n';
interface Props { dir: string; f: { key: string; p: any; alt: string } }
const { dir, f } = Astro.props;
const src = (w: number) => `/journal/${dir}/${f.key}-${w}.webp`;
---
<figure class="jfig">
  <img src={src(900)} srcset={`${src(900)} 900w, ${src(1600)} 1600w`} sizes="(max-width: 860px) 100vw, 780px" width="1600" height="1694" alt={f.alt} loading="lazy" decoding="async" />
  {f.p && <figcaption class="mono"><span>{f.p.name.en}</span><a href={productHref('en', f.p.slug)}>See the print →</a></figcaption>}
</figure>
