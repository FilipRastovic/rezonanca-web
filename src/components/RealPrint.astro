---
// Real photo of a printed, framed piece (not a mockup). variant: 'band' (homepage, collection) or 'card' (product page).
import { T, productHref, type Lang } from '../i18n';
interface Props { lang: Lang; variant?: 'band' | 'card' }
const { lang, variant = 'band' } = Astro.props;
const t = T[lang].real;
---
{variant === 'band' ? (
  <section class="real">
    <div class="wrap">
      <figure class="band corners" data-reveal>
        <img src="/photos/halvorsen-2-wide.webp" srcset="/photos/halvorsen-2-wide-sm.webp 900w, /photos/halvorsen-2-wide.webp 2000w" sizes="(max-width: 900px) 100vw, 1280px" alt={t.alt} loading="lazy" decoding="async" />
        <figcaption>
          <p class="label">{t.label}</p>
          <h2>{t.title}</h2>
          <p class="txt">{t.text}</p>
          <a class="btn" href={productHref(lang, 'halvorsen')}>{t.cta} <span class="arrow">→</span></a>
        </figcaption>
      </figure>
    </div>
  </section>
) : (
  <a class="rcard" href={productHref(lang, 'halvorsen')}>
    <img src="/photos/halvorsen-2-wide-sm.webp" alt={t.alt} loading="lazy" decoding="async" />
    <span><b class="mono">{t.label}</b>{t.caption}</span>
  </a>
)}
<style>
  .real { background: var(--bg-0); padding: var(--space-md) 0 0; }
  .band { position: relative; margin: 0; overflow: hidden; border: 1px solid var(--line); aspect-ratio: 16 / 9; }
  .band img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; }
  .band::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(2, 5, 13, 0.92) 0%, rgba(2, 5, 13, 0.7) 32%, transparent 62%); }
  figcaption { position: absolute; z-index: 1; left: clamp(20px, 4vw, 64px); top: 50%; transform: translateY(-50%); max-width: 420px; }
  h2 { font-size: var(--fs-h2); line-height: 1.1; margin-top: 14px; }
  .txt { margin: 16px 0 24px; color: var(--text); }
  @media (max-width: 760px) {
    .band { aspect-ratio: auto; display: flex; flex-direction: column; }
    .band img { position: relative; aspect-ratio: 4 / 3; object-position: 64% 50%; }
    .band::after { display: none; }
    figcaption { position: static; transform: none; padding: 22px 20px 26px; max-width: none; }
  }
  .rcard { display: grid; grid-template-columns: 112px 1fr; gap: 14px; align-items: center; margin-top: 18px; padding: 10px; border: 1px solid var(--line); background: rgba(3, 8, 20, 0.6); color: var(--text); transition: border-color 0.3s; }
  .rcard:hover { border-color: var(--line-strong); }
  .rcard img { width: 112px; height: 84px; object-fit: cover; object-position: 62% 50%; }
  .rcard span { font-size: var(--fs-sm, 14px); line-height: 1.5; }
  .rcard b { display: block; margin-bottom: 4px; font-size: var(--fs-2xs); letter-spacing: var(--track-ui); color: var(--cyan); font-weight: 400; }
</style>
