---
import Logo from './Logo.astro';
import { T, homeHref, collectionHref, altHref, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang].nav;
const home = homeHref(lang);
const links = [
  [collectionHref(lang), t.collection],
  [`${home}#interiors`, t.interiors],
  [`${home}#formats`, t.formats],
  [`${home}#how`, t.order],
  [`${home}#faq`, t.faq],
];
const path = Astro.url.pathname;
---
<header class="nav" id="nav">
  <div class="wrap inner">
    <a href={home} aria-label="Rezonanca"><Logo /></a>
    <nav aria-label="Main">
      {links.map(([href, label]) => <a href={href} class:list={{ on: href === path }}>{label}</a>)}
    </nav>
    <div class="right">
      <div class="lang mono" aria-label="Language">
        <a href={altHref(path, 'sr')} class:list={{ on: lang === 'sr' }} hreflang="sr">СР</a>
        <span>/</span>
        <a href={altHref(path, 'en')} class:list={{ on: lang === 'en' }} hreflang="en">EN</a>
      </div>
      <button class="btn btn--solid cta" data-order>{t.cta}</button>
    </div>
  </div>
</header>
<script>
  const nav = document.getElementById('nav')!;
  const onScroll = () => nav.classList.toggle('scrolled', scrollY > 40);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
<style>
  .nav { position: fixed; inset: 0 0 auto; z-index: 50; transition: background 0.4s, border-color 0.4s, backdrop-filter 0.4s; border-bottom: 1px solid transparent; }
  .nav.scrolled { background: rgba(1, 3, 10, 0.72); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-color: var(--line); }
  .inner { display: flex; align-items: center; justify-content: space-between; height: 68px; gap: 24px; }
  nav { display: flex; gap: 30px; }
  nav a { font: 500 var(--fs-xs)/1 var(--f-mono); letter-spacing: var(--track-ui); text-transform: uppercase; color: var(--muted); transition: color 0.3s; }
  nav a:hover, nav a.on { color: var(--cyan); }
  .right { display: flex; align-items: center; gap: 20px; }
  .lang { display: flex; gap: 6px; font-size: var(--fs-xs); color: var(--muted); }
  .lang a.on { color: var(--cyan); }
  .lang a:hover { color: var(--ice); }
  .cta { padding: 10px 16px; font-size: var(--fs-2xs); }
  @media (max-width: 980px) { nav { display: none; } }
  @media (max-width: 480px) { .cta { display: none; } }
</style>
