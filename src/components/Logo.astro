---
// Wordmark + descriptor line ("уметнички принтови" / "art prints") so the shop's purpose reads from the logo.
interface Props { size?: number; tag?: string; tagClass?: string }
const { size = 12, tag, tagClass } = Astro.props;
---
<span class="logo" style={`--s:${size}px`}>
  <svg viewBox="0 0 40 20" aria-hidden="true"><path d="M1 12h6l2.5-6 4 13 4-18 4 15 3-7 2.5 4H39" /></svg>
  <span class="words">
    <span class="name">РЕЗОНАНЦА</span>
    {tag && <span class:list={['tag', tagClass]}>{tag}</span>}
  </span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; font: 600 var(--s)/1 var(--f-display); letter-spacing: 0.3em; color: var(--ice); }
  .words { display: inline-flex; flex-direction: column; gap: calc(var(--s) * 0.45); }
  .tag { font: 400 calc(var(--s) * 0.72)/1 var(--f-mono); letter-spacing: var(--track-ui); text-transform: uppercase; color: var(--muted); white-space: nowrap; }
  /* In the nav, the full menu needs the room between 901 and 1180 px; mobile (burger menu) shows the line again. */
  @media (min-width: 901px) and (max-width: 1180px) { .nav-tag { display: none; } }
  svg { width: calc(var(--s) * 2.4); height: calc(var(--s) * 1.2); fill: none; stroke: var(--cyan); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
</style>
