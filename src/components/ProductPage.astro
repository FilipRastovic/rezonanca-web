---
import Base from '../layouts/Base.astro';
import ProductCard from './ProductCard.astro';
import ProductMath from './ProductMath.astro';
import History from './History.astro';
import MadeInSerbia from './MadeInSerbia.astro';
import { SERIES, PRODUCTS, findProduct, seriesOf, productsBySeries, pad, imgKey } from '../data/products.js';
import ROOM_FRAMES from '../data/room-frames.json';
import SWATCHES from '../data/swatches.json';
import { SHOP, SIZES, ACTIVE_FORMATS, FORMAT_SIZES, FRAMES, PRICES, SALES_OPEN, PRICES_VISIBLE, MIN_PRICE, MAX_PRICE, minPrice, formatPrice } from '../config';
import Waitlist from './Waitlist.astro';
import { T, homeHref, collectionHref, productHref, seriesShort, type Lang } from '../i18n';
interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const p = findProduct(slug)!;
const t = T[lang];
const tp = t.product;
const series = seriesOf(p)!;
const info = t.series[p.style as 'structure'];
const seriesName = seriesShort(lang, p.style);
const name = p.name[lang];
const related = productsBySeries(p.style).filter((x) => x.slug !== p.slug).slice(0, 4);
const others = SERIES.filter((s) => s.key !== p.style);
const fmt = t.formats.items;
const hasFrames = FRAMES.length > 1 && ACTIVE_FORMATS.some((f) => f === 'framed' || f === 'edition');
// Sizes offered by at least one active format; each pill lists the formats it belongs to.
const shownSizes = SIZES.filter((s) => ACTIVE_FORMATS.some((f) => FORMAT_SIZES[f].includes(s)));
// Picker order: cheapest first; every page opens on Принт неурамљен in its cheapest size.
const PICK = [...ACTIVE_FORMATS].sort((a, b) => minPrice(a) - minPrice(b));
const F0 = PICK.includes('print') ? 'print' : PICK[0]; // opens on the unframed poster (Принт неурамљен), cheapest size
const S0 = (Object.entries(PRICES[F0]) as [string, number][]).sort((a, b) => a[1] - b[1])[0][0];
// The main view follows the chosen format (what you see is what you get): bare print / mounted = the poster drawn
// with CSS; framed = room shot with that frame colour; Мини урамљен = the card in a small frame; Мини принт = the card.
const frames: Record<string, { black: string; oak: string }> = Object.fromEntries(
  ['', ...(p.tones || [])].map((tn) => { const k = imgKey(p.slug, tn); return [k, (ROOM_FRAMES as any)[k]]; }));
const lookOf = (f: string) => (f === 'framed' ? `framed-${FRAMES[0]}` : f);
const mainFor = (look: string, k: string): { src: string; fit: string } | null =>
  look === 'miniprint' ? { src: `/minis/card-${k}.webp`, fit: 'card' }
  : look === 'mini' ? { src: `/minis/framed-${k}.webp`, fit: 'room' }
  : look.startsWith('framed-') ? { src: `/rooms/${k}-${lang}${frames[k][look.slice(7) as 'black']}.webp`, fit: 'room' }
  : null;
const first = mainFor(lookOf(F0), p.slug);
const sizeFormats = (s: string) => ACTIVE_FORMATS.filter((f) => (FORMAT_SIZES[f] as string[]).includes(s)).join(' ');

// One gallery per colourway ('' = original); the colour choice swaps the whole set.
const tones = ['', ...(p.tones || [])];
const toneName = (tone: string) => t.order.tones[(tone || 'orig') as 'orig'];
const galleryFor = (tone: string) => {
  const k = imgKey(p.slug, tone), suffix = tone ? ` (${toneName(tone)})` : '';
  return [
    { src: `/posters/${k}-${lang}-lg.webp`, thumb: `/posters/${k}-${lang}.webp`, alt: `${seriesName} - ${name}${suffix}`, fit: 'poster' },
    // Room shots: the exact print in three mockup scenes (scripts/render-rooms.py).
    ...['', '-2', '-3'].map((n) => ({ src: `/rooms/${k}-${lang}${n}.webp`, thumb: `/rooms/${k}-${lang}${n}-sm.webp`, alt: `${name}${suffix} - ${tp.gallery[1]}`, fit: 'room' })),
    { src: `/details/${k}.webp`, thumb: `/details/${k}-sm.webp`, alt: `${name}${suffix} - ${tp.gallery[2]}`, fit: 'square' },
  ];
};
const galleries = Object.fromEntries(tones.map((tone) => [tone || 'orig', galleryFor(tone)]));
const gallery = galleries.orig;
// Swatch: one dot in the poster's dominant colour.
const swatch = (tone: string) => (SWATCHES as Record<string, string>)[imgKey(p.slug, tone)]; // dominant colour, scripts/swatches.mjs

const site = Astro.site!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${name} - ${seriesName}`,
  description: p.line[lang],
  image: new URL(gallery[0].src, site).href,
  sku: `RZ-${p.slug}`,
  brand: { '@type': 'Brand', name: 'Rezonanca' },
  ...(SALES_OPEN ? { offers: {
    '@type': 'AggregateOffer',
    priceCurrency: SHOP.currency,
    lowPrice: MIN_PRICE,
    highPrice: MAX_PRICE,
    availability: 'https://schema.org/InStock',
    url: new URL(productHref(lang, p.slug), site).href,
  } } : {}),
};
const cfg = JSON.stringify({ prices: PRICES_VISIBLE ? PRICES : {}, lang, frames });
---
<Base lang={lang} title={`${name} - ${seriesName} | Резонанца`} description={p.line[lang]} image={`/posters/${p.slug}-${lang}.webp`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="product grid-bg">
    <div class="wrap">
      <nav class="crumbs mono" aria-label="Breadcrumb">
        <a href={homeHref(lang)}>{tp.home}</a><span>/</span>
        <a href={collectionHref(lang)}>{t.collection.title}</a><span>/</span>
        <a href={collectionHref(lang, series.slug)}>{seriesName}</a><span>/</span>
        <span aria-current="page">{name}</span>
      </nav>

      <div class="layout">
        <div class="gallery">
          <figure class="main corners" data-fit={first ? first.fit : 'poster'} data-look={lookOf(F0)}>
            <button type="button" class="zoom" id="pp-zoom" aria-label={tp.lightbox.open}>
              <img id="pp-main" src={first ? first.src : gallery[0].src} alt={gallery[0].alt} width="1440" height="1920" fetchpriority="high" />
              <span class="zoom-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg></span>
            </button>
          </figure>
          <div class="thumbs" role="tablist">
            {gallery.map((g, i) => (
              <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-src={g.src} data-alt={g.alt} data-fit={g.fit}>
                <img src={g.thumb} alt="" loading="lazy" width="200" height="200" />
                <span class="mono">{tp.gallery[g.fit === 'poster' ? 0 : g.fit === 'room' ? 1 : 2]}</span>
              </button>
            ))}
          </div>
        </div>

        <script type="application/json" id="pp-galleries" set:html={JSON.stringify(galleries)} />
        <dialog class="lightbox" id="pp-lightbox" aria-label={name}>
          <img id="lb-img" src={gallery[0].src} alt={gallery[0].alt} />
          <button type="button" class="lb-btn lb-close" data-lb="close" aria-label={tp.lightbox.close}><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 5l14 14M19 5L5 19" /></svg></button>
          <button type="button" class="lb-btn lb-prev" data-lb="-1" aria-label={tp.lightbox.prev}><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 4l-8 8 8 8" /></svg></button>
          <button type="button" class="lb-btn lb-next" data-lb="1" aria-label={tp.lightbox.next}><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 4l8 8-8 8" /></svg></button>
          <p class="lb-count mono" id="lb-count"></p>
        </dialog>

        <form class="info" id="pp-form" data-config={cfg} onsubmit="return false" autocomplete="off">
          <p class="label">{info.code.split(' // ')[0]} // {seriesName}</p>
          <h1>{name}</h1>
          <p class="meta mono">{tp.no} {pad(p.seed)} · {t.variants[p.variant as 'burst']} · {t.palettes[p.palette as 'cyan']}</p>
          <p class="line">{p.line[lang]}</p>

          {SALES_OPEN || PRICES_VISIBLE ? (
            <div class="price">
              <strong id="pp-price">{formatPrice(PRICES[F0][S0 as keyof (typeof PRICES)[typeof F0]]!, lang)}</strong>
              <small>{SALES_OPEN ? tp.priceNote : T[lang].soon.priceOpenNote}</small>
            </div>
          ) : (
            <div class="price soon">
              <span class="badge mono">{T[lang].soon.badge}</span>
              <strong>{T[lang].soon.priceSoon}</strong>
              <small>{T[lang].soon.priceNote}</small>
            </div>
          )}

          {tones.length > 1 && (
            <fieldset>
              <legend class="mono">{t.order.color}</legend>
              <div class="pills">
                {tones.map((tone, i) => (
                  <label class="pill swatch"><input type="radio" name="tone" value={tone || 'orig'} checked={i === 0} /><span><i class="tone-sw" style={`background:${swatch(tone)}`}></i>{toneName(tone)}</span></label>
                ))}
              </div>
            </fieldset>
          )}

          {ACTIVE_FORMATS.length === 1 ? (
            <div class="fixed">
              <input type="hidden" name="format" value={ACTIVE_FORMATS[0]} />
              <p class="mono">{tp.format}</p>
              <strong>{fmt[ACTIVE_FORMATS[0]].t}</strong>
              <span>{fmt[ACTIVE_FORMATS[0]].spec.slice(0, 2).join(' · ')}</span>
            </div>
          ) : (
          <fieldset>
            <legend class="mono">{tp.format}</legend>
            <div class="formats">
              {PICK.map((f, i) => (
                <label class="fmt">
                  <input type="radio" name="format" value={f} checked={f === F0} />
                  <span class="box">
                    <strong>{fmt[f].t}</strong>
                    {PRICES_VISIBLE && <span class="mono">{tp.from} {formatPrice(minPrice(f), lang)}</span>}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
          )}

          <fieldset>
            <legend class="mono">{tp.size}</legend>
            <div class="pills">
              {shownSizes.map((s) => (
                <label class="pill" data-formats={sizeFormats(s)}><input type="radio" name="size" value={s} checked={s === S0} /><span>{s.replace('x', ' × ')} cm{s === '28x35' && <small> · {tp.matNote}</small>}</span></label>
              ))}
            </div>
          </fieldset>

          {!hasFrames && <input type="hidden" name="frame" value={FRAMES[0]} />}
          {hasFrames && <fieldset id="pp-frame" hidden>
            <legend class="mono">{tp.frame}</legend>
            <div class="pills">
              {FRAMES.map((f, i) => (
                <label class="pill swatch"><input type="radio" name="frame" value={f} checked={i === 0} /><span><i class={`sw-${f}`}></i>{t.order.frames[f]}</span></label>
              ))}
            </div>
          </fieldset>}

          {ACTIVE_FORMATS.includes('edition') && <p class="edition mono" id="pp-edition" hidden>✦ {tp.edition}</p>}

          {!SALES_OPEN && <div class="wait"><Waitlist lang={lang} product={{ slug: p.slug, name }} /></div>}
          <div class="buy" hidden={!SALES_OPEN}>
            <label class="qty"><span class="mono">{tp.qty}</span><span class="stepper"><button type="button" class="step" data-step="-1" aria-label="−">−</button><input type="number" name="qty" min="1" max="20" value="1" inputmode="numeric" /><button type="button" class="step" data-step="1" aria-label="+">+</button></span></label>
            <button type="button" class="btn btn--solid order" id="pp-order" data-slug={p.slug} data-format={F0} data-size={S0} data-frame={FRAMES[0]} data-qty="1">
              {T[lang].cart.add} <span class="arrow">→</span>
            </button>
          </div>

          <ul class="trust mono">{tp.trust.map((x) => <li>{x}</li>)}</ul>

          <div class="acc">
            <details open>
              <summary>{tp.about}</summary>
              <p>{info.desc}</p>
              <dl class="mono">
                <div><dt>{tp.aboutGen}</dt><dd>{pad(p.seed)}</dd></div>
                <div><dt>{tp.style}</dt><dd>{seriesName}</dd></div>
                <div><dt>{tp.variant}</dt><dd>{t.variants[p.variant as 'burst']}</dd></div>
                <div><dt>{tp.palette}</dt><dd>{t.palettes[p.palette as 'cyan']}</dd></div>
              </dl>
            </details>
            <details><summary>{tp.printTitle}</summary><p>{tp.printBody}</p></details>
            <details><summary>{tp.shipTitle}</summary><p>{tp.shipBody}</p></details>
          </div>
        </form>
      </div>
    </div>
  </section>

  <ProductMath lang={lang} slug={p.slug} style={p.style} />
  <History lang={lang} series={p.style} compact />

  <section class="related">
    <div class="wrap">
      <div class="rel-head">
        <h2>{tp.related}</h2>
        <a class="btn more" href={collectionHref(lang, series.slug)}>{t.series.viewAll} <span class="arrow">→</span></a>
      </div>
      <div class="grid">
        {related.map((r, i) => <ProductCard product={r} lang={lang} delay={i * 90} />)}
      </div>
      <p class="label other-label">{tp.otherSeries}</p>
      <div class="chips mono">
        {others.map((s) => <a href={collectionHref(lang, s.slug)}>{seriesShort(lang, s.key)}</a>)}
      </div>
    </div>
  </section>
  <MadeInSerbia lang={lang} compact />
</Base>

<script is:inline define:vars={{ vcName: p.name[lang], vcId: p.slug }}>window.rzTrack && window.rzTrack('ViewContent', { content_name: vcName, content_ids: [vcId], content_type: 'product' });</script>
<script>
  const form = document.getElementById('pp-form') as HTMLFormElement;
  const { prices, lang, frames } = JSON.parse(form.dataset.config!);
  const priceEl = document.getElementById('pp-price'); // absent while sales are closed
  const orderBtn = document.getElementById('pp-order')!;
  const frameSet = document.getElementById('pp-frame'); // only when a framed format is on sale
  const editionEl = document.getElementById('pp-edition');
  const money = (n: number) => `${n.toLocaleString(lang === 'sr' ? 'sr-RS' : 'en-US')} RSD`;

  const update = () => {
    const d = new FormData(form);
    const format = String(d.get('format'));
    // Only the sizes this format comes in; keep the choice valid.
    const pills = [...form.querySelectorAll<HTMLElement>('.pill[data-formats]')];
    for (const pl of pills) pl.hidden = !pl.dataset.formats!.split(' ').includes(format);
    const checked = form.querySelector<HTMLInputElement>('input[name="size"]:checked');
    if (!checked || checked.closest<HTMLElement>('.pill')!.hidden) {
      const first = pills.find((pl) => !pl.hidden)?.querySelector('input');
      if (first) first.checked = true;
    }
    const size = String(new FormData(form).get('size'));
    const qty = Math.max(1, Math.min(20, parseInt(String(d.get('qty')), 10) || 1));
    if (priceEl && prices[format]?.[size]) priceEl.textContent = money(prices[format][size] * qty);
    if (frameSet) frameSet.hidden = !['framed', 'edition'].includes(format);
    // The main poster view shows what you'd get: bare print, black/oak frame, black mat, or the framed mini.
    const look = format === 'framed' ? `framed-${String(d.get('frame') || 'black')}` : format;
    const figEl = document.querySelector<HTMLElement>('.main')!;
    const changed = figEl.dataset.look !== look;
    figEl.dataset.look = look;
    if (changed) document.dispatchEvent(new CustomEvent('pp:look'));
    if (editionEl) editionEl.hidden = format !== 'edition';
    Object.assign(orderBtn.dataset, { format, size, frame: String(d.get('frame')), qty: String(qty), tone: String(d.get('tone') || '') });
  };
  form.addEventListener('change', update);
  form.addEventListener('input', update);
  update();

  // Add to cart -> open the cart panel.
  import { add } from '../scripts/cart';
  orderBtn.addEventListener('click', () => {
    const d = orderBtn.dataset;
    add({ slug: d.slug!, format: d.format!, size: d.size!, frame: d.frame, qty: +(d.qty || 1), ...(d.tone && d.tone !== 'orig' ? { tone: d.tone } : {}) });
    document.dispatchEvent(new CustomEvent('cart:open'));
  });

  // Gallery.
  const main = document.getElementById('pp-main') as HTMLImageElement;
  const fig = main.closest('figure')!;
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('.thumbs button')];
  let current = 0;
  const show = (i: number) => {
    current = (i + thumbs.length) % thumbs.length;
    const b = thumbs[current];
    thumbs.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    main.src = b.dataset.src!;
    main.alt = b.dataset.alt!;
    fig.dataset.fit = b.dataset.fit!;
    // The first view follows the chosen format (same rules as mainFor in the frontmatter).
    if (b.dataset.fit === 'poster') {
      const look = fig.dataset.look!, tone = String(new FormData(form).get('tone') || 'orig');
      const k = orderBtn.dataset.slug + (tone !== 'orig' ? '-' + tone : '');
      const alt = look === 'miniprint' ? [`/minis/card-${k}.webp`, 'card']
        : look === 'mini' ? [`/minis/framed-${k}.webp`, 'room']
        : look.startsWith('framed-') ? [`/rooms/${k}-${lang}${frames[k][look.slice(7)]}.webp`, 'room'] : null;
      if (alt) { main.src = alt[0]; fig.dataset.fit = alt[1]; }
    }
  };
  // A new format or frame jumps back to the main view, so the click always shows that variant.
  document.addEventListener('pp:look', () => show(0));
  thumbs.forEach((b, i) => b.addEventListener('click', () => show(i)));

  // Colour choice: swap every gallery image to that colourway (what you see is what you get).
  const galleries = JSON.parse(document.getElementById('pp-galleries')!.textContent!);
  const setTone = (tone: string) => {
    const g = galleries[tone] || galleries.orig;
    thumbs.forEach((b, i) => {
      Object.assign(b.dataset, { src: g[i].src, alt: g[i].alt });
      (b.querySelector('img') as HTMLImageElement).src = g[i].thumb;
    });
    show(current);
  };
  form.querySelectorAll<HTMLInputElement>('input[name="tone"]').forEach((r) => r.addEventListener('change', () => setTone(r.value)));
  // ?boja=roza (e.g. from a pink card or a shared link) preselects the colour.
  const wanted = new URLSearchParams(location.search).get('boja');
  const pre = wanted && form.querySelector<HTMLInputElement>(`input[name="tone"][value="${CSS.escape(wanted)}"]`);
  if (pre) { pre.checked = true; setTone(wanted!); update(); }
  // Every visit starts on the first, cheapest option: the browser must not bring back
  // an earlier choice when the page is restored from back/forward.
  addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    form.reset();
    if (pre) pre.checked = true;
    setTone(pre ? wanted! : 'orig');
    update();
  });

  // Full screen view: tap the image; arrows, swipe, Esc or tap outside to close.
  const lb = document.getElementById('pp-lightbox') as HTMLDialogElement;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbCount = document.getElementById('lb-count')!;
  const lbShow = (i: number) => {
    show(i);
    lbImg.src = main.src;
    lbImg.alt = main.alt;
    lbCount.textContent = `${current + 1} / ${thumbs.length}`;
  };
  document.getElementById('pp-zoom')!.addEventListener('click', () => {
    lbShow(current);
    lb.showModal();
    document.documentElement.style.overflow = 'hidden';
  });
  lb.addEventListener('close', () => { document.documentElement.style.overflow = ''; });
  lb.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const btn = t.closest<HTMLElement>('[data-lb]');
    if (btn) return btn.dataset.lb === 'close' ? lb.close() : lbShow(current + Number(btn.dataset.lb));
    if (t !== lbImg) lb.close();
  });
  lb.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') lbShow(current + 1);
    if (e.key === 'ArrowLeft') lbShow(current - 1);
  });
  let x0: number | null = null, y0 = 0;
  lb.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
  lb.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
    x0 = null;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) lbShow(current + (dx < 0 ? 1 : -1));
  });
</script>

<style>
  .product { padding: clamp(112px, 10vw, 144px) 0 var(--space-md); background-color: var(--bg-0); }
  .crumbs { display: flex; gap: 10px; flex-wrap: wrap; font-size: var(--fs-2xs); letter-spacing: var(--track-ui); text-transform: uppercase; color: var(--muted); margin-bottom: 32px; }
  .crumbs a:hover { color: var(--cyan); }
  .crumbs [aria-current] { color: var(--ice); }
  .layout { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(40px, 7vw, 120px); align-items: start; }

  /* One fixed 3:4 frame for every view, so switching images never changes the height. */
  .main { margin: 0; position: relative; aspect-ratio: 3 / 4; background-color: #000; border: 1px solid var(--line); padding: 0; overflow: hidden; --l: 22px; }
  .zoom { display: block; position: relative; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .main img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .zoom-ico { position: absolute; right: 10px; bottom: 10px; display: grid; place-items: center; width: 34px; height: 34px; color: var(--ice); background: rgba(251, 250, 247, 0.6); border: 1px solid var(--line); opacity: 0.75; transition: opacity 0.3s, border-color 0.3s; }
  .zoom:hover .zoom-ico, .zoom:focus-visible .zoom-ico { opacity: 1; border-color: var(--cyan); }

  .lightbox { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(251, 250, 247, 0.96); color: var(--ice); overflow: hidden; }
  .lightbox::backdrop { background: rgba(251, 250, 247, 0.9); }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox img { max-width: calc(100vw - 32px); max-height: calc(100dvh - 96px); width: auto; height: auto; object-fit: contain; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6); }
  .lb-btn { position: absolute; display: grid; place-items: center; width: 48px; height: 48px; padding: 0; color: var(--ice); background: rgba(251, 250, 247, 0.6); border: 1px solid var(--line); cursor: pointer; transition: border-color 0.3s, color 0.3s; }
  .lb-btn:hover, .lb-btn:focus-visible { border-color: var(--cyan); color: var(--cyan); }
  .lb-close { top: 16px; right: 16px; }
  .lb-prev { left: 16px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 16px; top: 50%; transform: translateY(-50%); }
  .lb-count { position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); margin: 0; font-size: var(--fs-2xs); letter-spacing: var(--track-ui); color: var(--muted); }
