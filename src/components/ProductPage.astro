---
import Base from '../layouts/Base.astro';
import ProductCard from './ProductCard.astro';
import ProductMath from './ProductMath.astro';
import History from './History.astro';
import MadeInSerbia from './MadeInSerbia.astro';
import { SERIES, PRODUCTS, findProduct, seriesOf, productsBySeries, pad } from '../data/products.js';
import { SHOP, SIZES, FORMATS, FRAMES, PRICES, formatPrice } from '../config';
import { T, homeHref, collectionHref, productHref, seriesShort, type Lang } from '../i18n';
interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const p = findProduct(slug)!;
const t = T[lang];
const tp = t.product;
const series = seriesOf(p)!;
const info = t.series[p.style as 'structure'];
const seriesName = seriesShort(lang, p.style);
const name = p.name[lang];
const related = productsBySeries(p.style).filter((x) => x.slug !== p.slug).slice(0, 4);
const others = SERIES.filter((s) => s.key !== p.style);
const fmt = t.formats.items;

const gallery = [
  { src: `/posters/${p.slug}-${lang}-lg.webp`, thumb: `/posters/${p.slug}-${lang}.webp`, alt: `${seriesName} - ${name}`, fit: 'poster' },
  { src: `/rooms/${p.slug}-${lang}.webp`, thumb: `/rooms/${p.slug}-${lang}.webp`, alt: `${name} - ${tp.gallery[1]}`, fit: 'wide' },
  { src: `/details/${p.slug}.webp`, thumb: `/details/${p.slug}.webp`, alt: `${name} - ${tp.gallery[2]}`, fit: 'square' },
];

const site = Astro.site!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${name} - ${seriesName}`,
  description: p.line[lang],
  image: new URL(gallery[0].src, site).href,
  sku: `RZ-${p.slug}`,
  brand: { '@type': 'Brand', name: 'Rezonanca' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: SHOP.currency,
    lowPrice: Math.min(...FORMATS.map((f) => PRICES[f]['30x40'])),
    highPrice: Math.max(...FORMATS.map((f) => PRICES[f]['61x91'])),
    availability: 'https://schema.org/InStock',
    url: new URL(productHref(lang, p.slug), site).href,
  },
};
const cfg = JSON.stringify({ prices: PRICES, lang });
---
<Base lang={lang} title={`${name} - ${seriesName} | Резонанца`} description={p.line[lang]} image={`/posters/${p.slug}-${lang}.webp`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="product grid-bg">
    <div class="wrap">
      <nav class="crumbs mono" aria-label="Breadcrumb">
        <a href={homeHref(lang)}>{tp.home}</a><span>/</span>
        <a href={collectionHref(lang)}>{t.collection.title}</a><span>/</span>
        <a href={collectionHref(lang, series.slug)}>{seriesName}</a><span>/</span>
        <span aria-current="page">{name}</span>
      </nav>

      <div class="layout">
        <div class="gallery">
          <figure class="main corners" data-fit="poster">
            <img id="pp-main" src={gallery[0].src} alt={gallery[0].alt} width="1440" height="1920" fetchpriority="high" />
          </figure>
          <div class="thumbs" role="tablist">
            {gallery.map((g, i) => (
              <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-src={g.src} data-alt={g.alt} data-fit={g.fit}>
                <img src={g.thumb} alt="" loading="lazy" width="200" height="200" />
                <span class="mono">{tp.gallery[i]}</span>
              </button>
            ))}
          </div>
        </div>

        <form class="info" id="pp-form" data-config={cfg} onsubmit="return false">
          <p class="label">{info.code.split(' // ')[0]} // {seriesName}</p>
          <h1>{name}</h1>
          <p class="meta mono">{tp.no} {pad(p.seed)} · {t.variants[p.variant as 'burst']} · {t.palettes[p.palette as 'cyan']}</p>
          <p class="line">{p.line[lang]}</p>

          <div class="price">
            <strong id="pp-price">{formatPrice(PRICES.print['30x40'], lang)}</strong>
            <small>{tp.priceNote}</small>
          </div>

          <fieldset>
            <legend class="mono">{tp.format}</legend>
            <div class="formats">
              {FORMATS.map((f, i) => (
                <label class="fmt">
                  <input type="radio" name="format" value={f} checked={i === 0} />
                  <span class="box">
                    <strong>{fmt[f].t}</strong>
                    <span class="mono">{tp.from} {formatPrice(PRICES[f]['30x40'], lang)}</span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset>
            <legend class="mono">{tp.size}</legend>
            <div class="pills">
              {SIZES.map((s, i) => (
                <label class="pill"><input type="radio" name="size" value={s} checked={i === 0} /><span>{s.replace('x', ' × ')} cm</span></label>
              ))}
            </div>
          </fieldset>

          <fieldset id="pp-frame" hidden>
            <legend class="mono">{tp.frame}</legend>
            <div class="pills">
              {FRAMES.map((f, i) => (
                <label class="pill swatch"><input type="radio" name="frame" value={f} checked={i === 0} /><span><i class={`sw-${f}`}></i>{t.order.frames[f]}</span></label>
              ))}
            </div>
          </fieldset>

          <p class="edition mono" id="pp-edition" hidden>✦ {tp.edition}</p>

          <div class="buy">
            <label class="qty"><span class="mono">{tp.qty}</span><span class="stepper"><button type="button" class="step" data-step="-1" aria-label="−">−</button><input type="number" name="qty" min="1" max="20" value="1" inputmode="numeric" /><button type="button" class="step" data-step="1" aria-label="+">+</button></span></label>
            <button type="button" class="btn btn--solid order" id="pp-order" data-order data-poster={p.slug} data-format="print" data-size="30x40" data-frame="black" data-qty="1">
              {tp.order} <span class="arrow">→</span>
            </button>
          </div>

          <ul class="trust mono">{tp.trust.map((x) => <li>{x}</li>)}</ul>

          <div class="acc">
            <details open>
              <summary>{tp.about}</summary>
              <p>{info.desc}</p>
              <dl class="mono">
                <div><dt>{tp.aboutGen}</dt><dd>{pad(p.seed)}</dd></div>
                <div><dt>{tp.style}</dt><dd>{seriesName}</dd></div>
                <div><dt>{tp.variant}</dt><dd>{t.variants[p.variant as 'burst']}</dd></div>
                <div><dt>{tp.palette}</dt><dd>{t.palettes[p.palette as 'cyan']}</dd></div>
              </dl>
            </details>
            <details><summary>{tp.printTitle}</summary><p>{tp.printBody}</p></details>
            <details><summary>{tp.shipTitle}</summary><p>{tp.shipBody}</p></details>
          </div>
        </form>
      </div>
    </div>
  </section>

  <ProductMath lang={lang} slug={p.slug} style={p.style} />
  <History lang={lang} series={p.style} compact />

  <section class="related">
    <div class="wrap">
      <div class="rel-head">
        <h2>{tp.related}</h2>
        <a class="btn more" href={collectionHref(lang, series.slug)}>{t.series.viewAll} <span class="arrow">→</span></a>
      </div>
      <div class="grid">
        {related.map((r, i) => <ProductCard product={r} lang={lang} delay={i * 90} />)}
      </div>
      <p class="label other-label">{tp.otherSeries}</p>
      <div class="chips mono">
        {others.map((s) => <a href={collectionHref(lang, s.slug)}>{seriesShort(lang, s.key)}</a>)}
      </div>
    </div>
  </section>
  <MadeInSerbia lang={lang} />
</Base>

<script>
  const form = document.getElementById('pp-form') as HTMLFormElement;
  const { prices, lang } = JSON.parse(form.dataset.config!);
  const priceEl = document.getElementById('pp-price')!;
  const orderBtn = document.getElementById('pp-order')!;
  const frameSet = document.getElementById('pp-frame')!;
  const editionEl = document.getElementById('pp-edition')!;
  const money = (n: number) => `${n.toLocaleString(lang === 'sr' ? 'sr-RS' : 'en-US')} RSD`;

  const update = () => {
    const d = new FormData(form);
    const format = String(d.get('format')), size = String(d.get('size'));
    const qty = Math.max(1, Math.min(20, parseInt(String(d.get('qty')), 10) || 1));
    priceEl.textContent = money(prices[format][size] * qty);
    frameSet.hidden = !['framed', 'edition'].includes(format);
    editionEl.hidden = format !== 'edition';
    Object.assign(orderBtn.dataset, { format, size, frame: String(d.get('frame')), qty: String(qty) });
  };
  form.addEventListener('change', update);
  form.addEventListener('input', update);
  update();

  // Gallery.
  const main = document.getElementById('pp-main') as HTMLImageElement;
  const fig = main.parentElement!;
  document.querySelectorAll<HTMLButtonElement>('.thumbs button').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('.thumbs button').forEach((x) => x.setAttribute('aria-selected', 'false'));
    b.setAttribute('aria-selected', 'true');
    main.src = b.dataset.src!;
    main.alt = b.dataset.alt!;
    fig.dataset.fit = b.dataset.fit!;
  }));
</script>

<style>
  .product { padding: clamp(120px, 12vw, 168px) 0 var(--space-section); background-color: var(--bg-0); }
  .crumbs { display: flex; gap: 10px; flex-wrap: wrap; font-size: var(--fs-2xs); letter-spacing: var(--track-ui); text-transform: uppercase; color: var(--muted); margin-bottom: 32px; }
  .crumbs a:hover { color: var(--cyan); }
  .crumbs [aria-current] { color: var(--ice); }
  .layout { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(40px, 7vw, 120px); align-items: start; }

  /* One fixed 3:4 frame for every view, so switching images never changes the height. */
  .main { margin: 0; position: relative; aspect-ratio: 3 / 4; background-color: #000; border: 1px solid var(--line); padding: 0; overflow: hidden; --l: 22px; }
  .main img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .main[data-fit='poster'] { padding: var(--mat-pad); background: var(--mat); border: 8px solid var(--frame); box-shadow: var(--frame-shadow); }
  .main[data-fit='poster'] img { object-fit: contain; }
  .thumbs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 12px; }
  .thumbs button { padding: 0; border: 1px solid var(--line); background: #000; cursor: pointer; text-align: left; transition: border-color 0.3s; }
  .thumbs button[aria-selected='true'] { border-color: var(--cyan); box-shadow: var(--glow); }
  .thumbs img { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .thumbs span { display: block; padding: 8px 10px; font-size: var(--fs-2xs); letter-spacing: var(--track-ui); text-transform: uppercase; color: var(--muted); }

  .info { position: sticky; top: 100px; }
  h1 { font-size: var(--fs-h1); line-height: 1.1; margin-top: 16px; }
  .meta { margin: 14px 0 0; font-size: var(--fs-xs); color: var(--muted); letter-spacing: 0.14em; text-transform: uppercase; }
  .line { margin: 22px 0 0; font: 400 var(--fs-lead)/1.6 var(--f-body); color: var(--ice); }
  .price { display: flex; flex-direction: column; gap: 6px; margin: 28px 0 8px; padding: 20px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .price strong { font: 400 clamp(22px, 2vw, 28px)/1 var(--f-display); color: var(--ice); }
  .price small { color: var(--muted); font-size: var(--fs-sm); }

  fieldset { border: none; padding: 0; margin: 24px 0 0; }
  legend { font-size: var(--fs-2xs); letter-spacing: var(--track-label); text-transform: uppercase; color: var(--muted); margin-bottom: 12px; padding: 0; }
  input[type='radio'] { position: absolute; opacity: 0; pointer-events: none; }
  .formats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .fmt .box { display: flex; flex-direction: column; gap: 6px; padding: 14px 16px; border: 1px solid var(--line); cursor: pointer; transition: border-color 0.3s, background 0.3s; }
  .fmt .box strong { font: 500 var(--fs-sm)/1.2 var(--f-display); color: var(--ice); }
  .fmt .box span { font-size: var(--fs-2xs); color: var(--muted); }
  .fmt input:checked + .box { border-color: var(--cyan); background: rgba(80, 230, 255, 0.07); }
  .fmt input:focus-visible + .box, .pill input:focus-visible + span { outline: 1px solid var(--cyan); outline-offset: 3px; }
  .pills { display: flex; flex-wrap: wrap; gap: 10px; }
  .pill span { display: inline-flex; align-items: center; gap: 8px; padding: 11px 16px; border: 1px solid var(--line); font-size: var(--fs-sm); color: var(--text); cursor: pointer; transition: border-color 0.3s, color 0.3s; }
  .pill input:checked + span { border-color: var(--cyan); color: var(--ice); background: rgba(80, 230, 255, 0.07); }
  .swatch i { width: 14px; height: 14px; border: 1px solid var(--line-strong); }
  .sw-black { background: #0b0b0d; } .sw-white { background: #f2f2ee; } .sw-oak { background: #b08455; }
  .edition { margin: 18px 0 0; font-size: var(--fs-xs); color: var(--cyan); letter-spacing: 0.08em; }

  .buy { display: flex; gap: 12px; align-items: end; margin-top: 28px; }
  .qty { display: flex; flex-direction: column; gap: 8px; }
  .qty span { font-size: var(--fs-2xs); letter-spacing: var(--track-label); text-transform: uppercase; color: var(--muted); }

  .order { flex: 1; justify-content: center; padding: 0 18px; height: 52px; }
  .trust { list-style: none; padding: 0; margin: 22px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: var(--fs-2xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .trust li::before { content: '✓ '; color: var(--cyan); }

  .acc { margin-top: 32px; border-top: 1px solid var(--line); }
  .acc details { border-bottom: 1px solid var(--line); }
  .acc summary { cursor: pointer; list-style: none; padding: 18px 0; font: 500 var(--fs-name)/1.3 var(--f-display); color: var(--ice); display: flex; justify-content: space-between; }
  .acc summary::-webkit-details-marker { display: none; }
  .acc summary::after { content: '+'; color: var(--cyan); }
  .acc details[open] summary::after { content: '–'; }
  .acc p { margin: 0 0 18px; color: var(--text); font-size: var(--fs-body); }
  dl { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 0 0 20px; font-size: var(--fs-2xs); letter-spacing: 0.12em; text-transform: uppercase; }
  dt { color: var(--muted); } dd { margin: 4px 0 0; color: var(--ice); }

  .related { background: linear-gradient(var(--bg-0), var(--bg-1)); }
  .rel-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; flex-wrap: wrap; margin-bottom: clamp(36px, 4vw, 64px); }
  .rel-head h2 { margin: 0; font-size: var(--fs-h2); }
  .more { padding: 12px 18px; font-size: var(--fs-2xs); }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(16px, 1.8vw, 28px); }
  @media (max-width: 1100px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
  .other-label { margin-top: var(--space-block); }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .chips a { padding: 11px 16px; border: 1px solid var(--line); font-size: var(--fs-xs); letter-spacing: 0.14em; text-transform: uppercase; }
  .chips a:hover { border-color: var(--cyan); color: var(--cyan); }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .info { position: static; }
  }
  @media (max-width: 420px) { .formats { grid-template-columns: 1fr; } .trust { grid-template-columns: 1fr; } }
</style>
