---
import { T, collectionHref, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang].final;
---
<section class="final">
  <svg class="line" viewBox="0 0 1200 200" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 100 H380 L400 70 L420 140 L440 30 L460 170 L480 50 L500 130 L520 80 L540 115 L560 95 L580 104 H620 L640 60 L660 150 L680 20 L700 180 L720 60 L740 125 L760 92 L780 100 H1200" />
  </svg>
  <div class="wrap inner">
    <h2 data-reveal>{t.title}</h2>
    <p class="lead" data-reveal>{t.lead}</p>
    <a class="btn btn--solid" href={collectionHref(lang)} data-reveal>{T[lang].hero.primary} <span class="arrow">→</span></a>
  </div>
</section>
<style>
  .final { overflow: hidden; text-align: center; background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(35, 105, 255, 0.22), transparent 70%), var(--bg-0); }
  .line { position: absolute; left: 0; top: 50%; width: 100%; height: 200px; transform: translateY(-50%); fill: none; stroke: var(--cyan); stroke-width: 1.2; opacity: 0.35; filter: drop-shadow(0 0 10px rgba(80, 230, 255, 0.8)); stroke-dasharray: 1600; animation: pulse 6s linear infinite; }
  @keyframes pulse { from { stroke-dashoffset: 3200; } to { stroke-dashoffset: 0; } }
  .inner { position: relative; display: flex; flex-direction: column; align-items: center; }
  h2 { max-width: 16ch; font-size: clamp(26px, 3.6vw, 52px); font-weight: 300; text-shadow: 0 0 60px rgba(80, 230, 255, 0.35); }
  .lead { margin: 24px auto 40px; }
  @media (prefers-reduced-motion: reduce) { .line { animation: none; stroke-dasharray: none; } }
</style>
