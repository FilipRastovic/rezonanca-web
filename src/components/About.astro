---
// "О мени": who makes Rezonanca (facts from filiprastovic.com/llms.txt). Photo: public/about/filip.webp.
import { T, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang].about;
---
<section id="about" class="about">
  <div class="wrap grid">
    <div class="who" data-reveal>
      <img src="/about/filip.webp" alt={t.alt} width="600" height="600" loading="lazy" decoding="async" />
      <div>
        <p class="name">{t.name}</p>
        <p class="role">{t.role}</p>
      </div>
    </div>
    <div class="text">
      <p class="label" data-reveal>{t.label}</p>
      <h2 data-reveal>{t.title}</h2>
      {t.body.map((b: string) => <p class="p" data-reveal>{b}</p>)}
      <a class="link" href="https://filiprastovic.com/" target="_blank" rel="noopener">filiprastovic.com <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
<style>
  .about { background: var(--bg-0); border-top: 1px solid var(--line); padding: var(--space-block) 0; }
  .grid { display: grid; grid-template-columns: 4fr 8fr; gap: clamp(32px, 6vw, 112px); align-items: start; }
  .who { display: flex; flex-direction: column; gap: 18px; }
  .who img { width: min(220px, 60%); aspect-ratio: 1; object-fit: cover; filter: grayscale(1) contrast(1.05); }
  .name { margin: 0; font: 500 var(--fs-h3)/1.3 var(--f-display); color: var(--ice); }
  .role { margin: 4px 0 0; font-size: var(--fs-sm); color: var(--muted); }
  .p { margin: 18px 0 0; max-width: 60ch; color: var(--text); }
  h2 { margin-bottom: 8px; }
  .link { display: inline-block; margin-top: 28px; font-size: var(--fs-xs); letter-spacing: var(--track-ui); text-transform: uppercase; color: var(--ice); border-bottom: 1px solid var(--line-strong); padding-bottom: 4px; }
  .link:hover { border-color: var(--ice); }
  @media (max-width: 800px) { .grid { grid-template-columns: 1fr; } .who { flex-direction: row; align-items: center; } .who img { width: 96px; } }
</style>
