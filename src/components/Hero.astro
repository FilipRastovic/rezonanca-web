---
import { T, collectionHref, productHref, type Lang } from '../i18n';
import { findProduct } from '../data/products.js';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang].hero;
// Two columns: text left (5/12), a small print collage right (7/12): a room shot of a framed print, plus a column with
// a small framed print at a tilt and a Мини урамљен mockup. Each slot cycles through pieces; nothing overlaps.
// [piece, room shot suffix] picked so the four room views are four different scenes (public/rooms, render-rooms.py).
const SHOW = ([['halvorsen', ''], ['dolina-morskih-konjica', '-2'], ['lorenc', '-2'], ['aizava', '-2']] as const).map(([s, n]) => ({ ...findProduct(s), shot: n }));
// Tilted framed print: its own pieces (two pink colourways for variety); [slug, poster key].
const TILT = [['tomas', 'tomas'], ['dvostruka-spirala', 'dvostruka-spirala-roza'], ['perje', 'perje'], ['kula', 'kula-roza']];
const MINIS = ['spirala', 'oreol', 'mandelbrotov-skup', 'drvo-signala'].map(findProduct);
---
<section class="hero" aria-label={t.title}>
  <div class="lines" id="hero-lines" aria-hidden="true"></div>

  <div class="wrap grid">
    <div class="content">
      <p class="label">{t.label}</p>
      <h1 class="title" aria-label={t.title}>
        {[...t.title].map((ch, i) => <span style={`--i:${i}`}>{ch}</span>)}
      </h1>
      <p class="lead">{t.lead}</p>
      <div class="actions">
        <a class="btn btn--solid" href={collectionHref(lang)}>{t.primary} <span class="arrow">→</span></a>
      </div>
    </div>

    <div class="collage" style={`--n:${SHOW.length}`}>
      <div class="side">
        <a class="tilt" href={productHref(lang, TILT[0][0])} aria-label={`${findProduct(TILT[0][0]).name[lang]} - ${t.framed}`}>
          <span class="pframe">
            {TILT.map(([, key], i) => <img src={`/posters/${key}-${lang}.webp`} alt="" width="900" height="1200" decoding="async" style={`--i:${i}; --off:1.2s`} />)}
          </span>
        </a>
        <a class="tile mini" href={productHref(lang, MINIS[0].slug)} aria-label={`${MINIS[0].name[lang]} - ${t.mini}`}>
          {MINIS.map((p, i) => <img src={`/minis/framed-${p.slug}.webp`} alt="" width="800" height="1067" decoding="async" style={`--i:${i}; --off:2.5s`} />)}
        </a>
      </div>
      <figure class="main-shot">
        <a class="tile big" href={productHref(lang, SHOW[0].slug)} aria-label={`${SHOW[0].name[lang]} - ${t.framed}`}>
          {SHOW.map((p, i) => (
            <img src={`/rooms/${p.slug}-${lang}${p.shot}-sm.webp`} srcset={`/rooms/${p.slug}-${lang}${p.shot}-sm.webp 480w, /rooms/${p.slug}-${lang}${p.shot}.webp 800w`} sizes="(max-width: 900px) 64vw, 34vw" alt={i === 0 ? `${p.name[lang]} - ${t.framed}` : ''} style={`--i:${i}`} width="540" height="720" fetchpriority={i === 0 ? 'high' : 'low'} decoding="async" />
          ))}
        </a>
        <figcaption class="caps">
          {SHOW.map((p, i) => <p style={`--i:${i}`}><b>{p.name[lang]}</b> <span>{t.framed}</span></p>)}
        </figcaption>
      </figure>
    </div>
  </div>

  <!-- What you get, in plain facts (real spec: matte 180 g, 12-colour pigment print, 300 DPI). -->
  <div class="wrap">
    <ul class="facts">
      {t.facts.map((f, i) => <li><span class="n">0{i + 1}</span>{f}</li>)}
    </ul>
  </div>
</section>

<script>
  import { mountHeroLines } from '../scripts/hero-lines';
  mountHeroLines(document.getElementById('hero-lines')!);
</script>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: center; gap: clamp(48px, 6vw, 88px); padding: 120px 0 clamp(32px, 4vw, 56px); border-bottom: 1px solid var(--line); overflow: hidden; background: var(--bg-0); }
  /* Background: flowing noise lines (scripts/hero-lines.ts), faded out under the text. */
  .lines { position: absolute; inset: 0; pointer-events: none; -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.25) 30%, #000 62%); mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.25) 30%, #000 62%); }
  .lines :global(canvas) { display: block; }

  .grid { position: relative; z-index: 2; display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 5vw, 96px); align-items: center; }
  .title { display: flex; flex-wrap: nowrap; white-space: nowrap; margin: 24px 0 0; font-size: clamp(34px, 4.6vw, 68px); font-weight: 600; line-height: 1; letter-spacing: 0.06em; color: var(--ice); }
  .title span { display: inline-block; animation: tune 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(var(--i) * 70ms + 200ms); }
  @keyframes tune {
    0% { opacity: 0; filter: blur(14px); transform: translateY(0.25em) scaleY(1.6); }
    60% { opacity: 1; filter: blur(0); }
    100% { opacity: 1; filter: blur(0); transform: none; }
  }
  .lead { margin: 28px 0 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }

  /* Collage: side column (detail square + framed mini) and the big room shot, bottoms aligned. */
  .collage { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(12px, 1.4vw, 20px); align-items: end; --cycle: calc(var(--n) * 5s); }
  .side { display: grid; gap: clamp(12px, 1.4vw, 20px); }
  .main-shot { position: relative; margin: 0; }
  .tile { position: relative; display: block; overflow: hidden; background: var(--bg-1); box-shadow: 0 24px 60px -32px rgba(18, 20, 23, 0.35); transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .tile:hover { transform: translateY(-4px); }
  /* A small framed print standing at a slight tilt (object, not photo); cycles with the big shot. */
  .tilt { position: relative; display: block; aspect-ratio: 1; }
  .pframe { position: absolute; left: 50%; top: 50%; width: 64%; aspect-ratio: 3 / 4.1; transform: translate(-50%, -50%) rotate(-6deg); background: #fff; border: 7px solid #121417; box-shadow: 0 1px 1px rgba(0,0,0,.25), 4px 10px 16px -4px rgba(18,20,23,.3), 14px 30px 50px -18px rgba(18,20,23,.45); transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); --cycle: calc(var(--n) * 5s); }
  .tilt:hover .pframe { transform: translate(-50%, -52%) rotate(-3deg); }
  .pframe img { position: absolute; inset: 9%; width: 82%; height: 82%; object-fit: cover; opacity: 0; animation: show var(--cycle) infinite; animation-delay: calc(var(--i) * 5s + var(--off, 0s) - 0.01s); }
  .pframe img:first-child { opacity: 1; }
  .mini, .big { aspect-ratio: 3 / 4; }
  .tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; animation: show var(--cycle) infinite; animation-delay: calc(var(--i) * 5s + var(--off, 0s) - 0.01s); }
  .tile img:first-child { opacity: 1; }
  @keyframes show { 0%, 21% { opacity: 1; } 27%, 94% { opacity: 0; } 100% { opacity: 1; } }
  .caps { position: absolute; left: 0; right: 0; top: calc(100% + 16px); height: 1.6em; font-size: var(--fs-2xs); letter-spacing: var(--track-ui); text-transform: uppercase; color: var(--muted); }
  .caps p { position: absolute; inset: 0 0 auto 0; margin: 0; opacity: 0; animation: show var(--cycle) infinite; animation-delay: calc(var(--i) * 5s - 0.01s); }
  .caps p:first-child { opacity: 1; }
  .caps b { color: var(--ice); font-weight: 500; margin-right: 10px; }

  /* Print facts strip */
  .facts { position: relative; z-index: 2; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
  .facts li { display: flex; align-items: baseline; gap: 14px; padding: 18px 0 0; font-size: var(--fs-sm); color: var(--ice); }
  .facts .n { font-size: var(--fs-2xs); letter-spacing: var(--track-ui); color: var(--muted); }

  @media (max-width: 900px) {
    .hero { justify-content: flex-start; padding-top: 110px; }
    .grid { grid-template-columns: 1fr; }
    .collage { max-width: 560px; margin-bottom: 36px; }
    .facts { grid-template-columns: 1fr 1fr; row-gap: 4px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .title span, .tile img, .pframe img, .caps p { animation: none; }
  }
</style>
